<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Liste des produits -->
    <record id="view_imobilier_sn_property_list" model="ir.ui.view">
        <field name="name">imobilier.sn.product.list</field>
        <field name="model">imobilier.sn.property</field>
        <field name="arch" type="xml">
            <list string="Produits">
                <field name="reference"/>
                <field name="property_type"/>
                <field name="owner_id"/>
                <field name="location"/>
                <field name="region_name"/>
                <field name="department_name"/>
                <field name="price"/>
                <field name="security_deposit"/>
                <field name="payment_term_id"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- Recherche des produits -->
    <record id="view_imobilier_sn_property_search" model="ir.ui.view">
        <field name="name">imobilier.sn.product.search</field>
        <field name="model">imobilier.sn.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="owner_id"/>
                <field name="location"/>
                <field name="region_name"/>
                <field name="department_name"/>
                <field name="property_type"/>
                <filter name="available" string="Disponibles" domain="[('status','=','available')]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by':'property_type'}"/>
                    <filter name="group_owner" string="Propriétaire" context="{'group_by':'owner_id'}"/>
                    <filter name="group_status" string="État" context="{'group_by':'status'}"/>
                    <filter name="group_region" string="Région" context="{'group_by':'region_name'}"/>
                    <filter name="group_department" string="Département" context="{'group_by':'department_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Formulaire Produit -->
    <record id="view_imobilier_sn_property_form" model="ir.ui.view">
        <field name="name">imobilier.sn.product.form</field>
        <field name="model">imobilier.sn.property</field>
        <field name="arch" type="xml">
            <form string="Produit">
                <header>
                    <button name="action_mark_available"
                            type="object"
                            string="Disponible"
                            class="btn-primary"
                            invisible="status == 'available'"/>
                    <button name="action_mark_reserved"
                            type="object"
                            string="Réserver"
                            invisible="status != 'available'"/>
                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="available,reserved,rented,sold,unavailable"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object"
                                name="action_open_contracts"
                                class="oe_stat_button"
                                icon="fa-file-text-o">
                            <field name="contract_count"
                                   string="Contrats"
                                   widget="statinfo"/>
                        </button>
                        <button type="object"
                                name="action_open_assignments"
                                class="oe_stat_button"
                                icon="fa-handshake-o">
                            <field name="assignment_count"
                                   string="Courtiers"
                                   widget="statinfo"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="reference"
                                   placeholder="Référence du produit"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Identification">
                            <field name="property_type"/>
                            <field name="owner_id"/>
                            <field name="website_published"/>
                            <field name="product_id"
                                   readonly="1"
                                   options="{'no_open': True}"/>
                            <button name="action_open_website"
                                    type="object"
                                    string="Voir sur le site"
                                    icon="fa-globe"
                                    invisible="not website_published"/>
                        </group>
                        <group string="Informations financières">
                            <field name="currency_id" invisible="1"/>
                            <field name="price"/>
                            <field name="security_deposit_months"
                                   invisible="property_type not in ['apartment','shop']"/>
                            <field name="security_deposit"
                                   invisible="property_type not in ['apartment','shop']"/>
                            <field name="payment_term_id"
                                   invisible="property_type not in ['house','land']"/>
                        </group>
                    </group>

                    <group string="Localisation">
                        <group>
                            <field name="location"
                                   placeholder="Adresse complète du produit : rue, quartier, immeuble, villa..."/>
                            <button name="action_geocode_address"
                                    type="object"
                                    string="Localiser et déterminer la région / le département"
                                    icon="fa-map-marker"
                                    class="btn-primary"/>
                        </group>
                        <group>
                            <field name="region_name"/>
                            <field name="department_name"/>
                            <field name="geocoded_address"
                                   invisible="not geocoded_address"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Courtier">
                            <field name="assignment_ids">
                                <list editable="bottom">
                                    <field name="broker_id"/>
                                    <field name="commission_percent"/>
                                    <field name="commission_amount"/>
                                    <field name="date_assigned"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <page string="Contrats">
                            <field name="contract_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="contract_type"/>
                                    <field name="customer_id"/>
                                    <field name="date_start"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <page string="Description">
                            <field name="description"
                                   nolabel="1"
                                   placeholder="Description du produit..."/>
                        </page>

                        <page string="Localisation et carte">
                            <group string="Coordonnées GPS"
                                   invisible="not latitude or not longitude">
                                <group>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                    <field name="geocoded_address"
                                           invisible="not geocoded_address"/>
                                </group>
                                <group>
                                    <button name="action_geocode_address"
                                            type="object"
                                            string="Actualiser la géolocalisation"
                                            icon="fa-map-marker"
                                            class="btn-primary"/>
                                    <button name="action_open_google_maps"
                                            type="object"
                                            string="Ouvrir dans Google Maps"
                                            icon="fa-external-link"
                                            class="btn-secondary"/>
                                </group>
                            </group>

                            <group string="Carte"
                                   invisible="not latitude or not longitude">
                                <field name="map_embed_html"
                                       widget="html"
                                       nolabel="1"
                                       readonly="1"/>
                            </group>
                        </page>
                    </notebook>

                    <!-- Informations spécifiques au type de produit -->
                    <group string="Appartement"
                           invisible="property_type != 'apartment'">
                        <group>
                            <field name="apartment_type_id"/>
                            <field name="apartment_number"/>
                        </group>
                    </group>

                    <group string="Maison entière"
                           invisible="property_type != 'house'">
                        <group>
                            <field name="house_type_id"/>
                            <field name="paper_type_id"/>
                        </group>
                        <separator string="Répartition des appartements"/>
                        <field name="house_unit_ids">
                            <list editable="bottom">
                                <field name="apartment_type_id"/>
                                <field name="quantity"/>
                                <field name="note"/>
                            </list>
                        </field>
                    </group>

                    <group string="Magasin"
                           invisible="property_type != 'shop'">
                        <group>
                            <field name="desired_activity"/>
                        </group>
                    </group>

                    <group string="Terrain"
                           invisible="property_type != 'land'">
                        <group>
                            <field name="land_area"/>
                            <field name="land_area_unit"/>
                            <field name="paper_type_id"/>
                        </group>
                    </group>



                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action globale Produit -->
    <record id="action_imobilier_sn_products" model="ir.actions.act_window">
        <field name="name">Produits</field>
        <field name="res_model">imobilier.sn.property</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_imobilier_sn_property_search"/>
    </record>

    <!-- Actions par type : le contexte initialise le type à l'ouverture du formulaire -->
    <record id="action_imobilier_sn_product_apartment" model="ir.actions.act_window">
        <field name="name">Appartements</field>
        <field name="res_model">imobilier.sn.property</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_type','=','apartment')]</field>
        <field name="context">{'default_property_type': 'apartment'}</field>
        <field name="search_view_id" ref="view_imobilier_sn_property_search"/>
    </record>

    <record id="action_imobilier_sn_product_house" model="ir.actions.act_window">
        <field name="name">Maisons entières</field>
        <field name="res_model">imobilier.sn.property</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_type','=','house')]</field>
        <field name="context">{'default_property_type': 'house'}</field>
        <field name="search_view_id" ref="view_imobilier_sn_property_search"/>
    </record>

    <record id="action_imobilier_sn_product_shop" model="ir.actions.act_window">
        <field name="name">Magasins</field>
        <field name="res_model">imobilier.sn.property</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_type','=','shop')]</field>
        <field name="context">{'default_property_type': 'shop'}</field>
        <field name="search_view_id" ref="view_imobilier_sn_property_search"/>
    </record>

    <record id="action_imobilier_sn_product_land" model="ir.actions.act_window">
        <field name="name">Terrains</field>
        <field name="res_model">imobilier.sn.property</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_type','=','land')]</field>
        <field name="context">{'default_property_type': 'land'}</field>
        <field name="search_view_id" ref="view_imobilier_sn_property_search"/>
    </record>

    <!-- Compatibilité avec l'ancien identifiant d'action -->
    <record id="action_imobilier_sn_property" model="ir.actions.act_window">
        <field name="name">Produits</field>
        <field name="res_model">imobilier.sn.property</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_imobilier_sn_property_search"/>
    </record>
</odoo>
