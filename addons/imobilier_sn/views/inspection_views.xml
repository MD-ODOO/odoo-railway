<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_imobilier_sn_inspection_list" model="ir.ui.view">
        <field name="name">imobilier.sn.inspection.list</field>
        <field name="model">imobilier.sn.inspection</field>
        <field name="arch" type="xml">
            <list string="États des lieux">
                <field name="name"/>
                <field name="inspection_type"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="inspection_date"/>
                <field name="condition"/>
            </list>
        </field>
    </record>

    <record id="view_imobilier_sn_inspection_form" model="ir.ui.view">
        <field name="name">imobilier.sn.inspection.form</field>
        <field name="model">imobilier.sn.inspection</field>
        <field name="arch" type="xml">
            <form string="État des lieux">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="contract_id"/>
                        <field name="property_id"/>
                        <field name="tenant_id"/>
                        <field name="inspection_type"/>
                        <field name="inspection_date"/>
                        <field name="condition"/>
                    </group>
                    <group>
                        <field name="meter_electricity"/>
                        <field name="meter_water"/>
                        <field name="keys_count"/>
                    </group>
                    <field name="description"/>
                    <group>
                        <field name="attachment" filename="attachment_filename"/>
                        <field name="attachment_filename" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_imobilier_sn_inspection" model="ir.actions.act_window">
        <field name="name">États des lieux</field>
        <field name="res_model">imobilier.sn.inspection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
