<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_imobilier_sn_assignment_list" model="ir.ui.view">
        <field name="name">imobilier.sn.assignment.list</field>
        <field name="model">imobilier.sn.assignment</field>
        <field name="arch" type="xml">
            <list string="Courtiers / Affectations">
                <field name="name"/>
                <field name="property_id"/>
                <field name="broker_id"/>
                <field name="commission_percent"/>
                <field name="commission_amount"/>
                <field name="date_assigned"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_imobilier_sn_assignment_form" model="ir.ui.view">
        <field name="name">imobilier.sn.assignment.form</field>
        <field name="model">imobilier.sn.assignment</field>
        <field name="arch" type="xml">
            <form string="Affectation courtier">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="property_id"/>
                        <field name="broker_id"/>
                        <field name="commission_percent"/>
                        <field name="commission_amount"/>
                        <field name="date_assigned"/>
                        <field name="state"/>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_imobilier_sn_assignment" model="ir.actions.act_window">
        <field name="name">Courtiers / Affectations</field>
        <field name="res_model">imobilier.sn.assignment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
