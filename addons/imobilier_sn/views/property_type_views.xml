<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_imobilier_sn_property_type_list" model="ir.ui.view">
        <field name="name">imobilier.sn.property.type.list</field>
        <field name="model">imobilier.sn.property.type</field>
        <field name="arch" type="xml">
            <list string="Types configurables">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_imobilier_sn_property_type_search" model="ir.ui.view">
        <field name="name">imobilier.sn.property.type.search</field>
        <field name="model">imobilier.sn.property.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <filter name="active" string="Actifs" domain="[('active','=',True)]"/>
                <group>
                    <filter name="group_category" string="Catégorie" context="{'group_by':'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_imobilier_sn_property_type_form" model="ir.ui.view">
        <field name="name">imobilier.sn.property.type.form</field>
        <field name="model">imobilier.sn.property.type</field>
        <field name="arch" type="xml">
            <form string="Type configurable">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="category"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_imobilier_sn_property_types" model="ir.actions.act_window">
        <field name="name">Types configurables</field>
        <field name="res_model">imobilier.sn.property.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_imobilier_sn_property_type_search"/>
    </record>

    <record id="action_imobilier_sn_apartment_types" model="ir.actions.act_window">
        <field name="name">Types d'appartement</field>
        <field name="res_model">imobilier.sn.property.type</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('category','=','apartment')]</field>
        <field name="context">{'default_category':'apartment'}</field>
        <field name="search_view_id" ref="view_imobilier_sn_property_type_search"/>
    </record>

    <record id="action_imobilier_sn_house_types" model="ir.actions.act_window">
        <field name="name">Types de maison</field>
        <field name="res_model">imobilier.sn.property.type</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('category','=','house')]</field>
        <field name="context">{'default_category':'house'}</field>
        <field name="search_view_id" ref="view_imobilier_sn_property_type_search"/>
    </record>

    <record id="action_imobilier_sn_paper_types" model="ir.actions.act_window">
        <field name="name">Types de papier</field>
        <field name="res_model">imobilier.sn.property.type</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('category','=','paper')]</field>
        <field name="context">{'default_category':'paper'}</field>
        <field name="search_view_id" ref="view_imobilier_sn_property_type_search"/>
    </record>
</odoo>
