<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_imobilier_sn" model="ir.ui.view">
        <field name="name">res.partner.form.imobilier.sn</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_imobilier_all_properties" class="oe_stat_button" icon="fa-building">
                    <field name="imobilier_total_count" string="Produits" widget="statinfo"/>
                </button>
                <button type="object" name="action_imobilier_apartments" class="oe_stat_button" icon="fa-home">
                    <field name="imobilier_apartment_count" string="Appartements" widget="statinfo"/>
                </button>
                <button type="object" name="action_imobilier_houses" class="oe_stat_button" icon="fa-building-o">
                    <field name="imobilier_house_count" string="Maisons" widget="statinfo"/>
                </button>
                <button type="object" name="action_imobilier_shops" class="oe_stat_button" icon="fa-shopping-bag">
                    <field name="imobilier_shop_count" string="Magasins" widget="statinfo"/>
                </button>
                <button type="object" name="action_imobilier_lands" class="oe_stat_button" icon="fa-map-o">
                    <field name="imobilier_land_count" string="Terrains" widget="statinfo"/>
                </button>
                <button type="object" name="action_imobilier_broker_assignments" class="oe_stat_button" icon="fa-handshake-o" invisible="not is_imobilier_broker">
                    <field name="imobilier_broker_assignment_count" string="Courtage" widget="statinfo"/>
                </button>
            </xpath>

            <xpath expr="//sheet/notebook" position="inside">
                <page string="Immobilier SN">
                    <group>
                        <group>
                            <field name="is_imobilier_broker"/>
                            <field name="broker_commission_percent" invisible="not is_imobilier_broker"/>
                            <field name="is_imobilier_tenant"/>
                            <field name="is_imobilier_owner"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    
    <record id="action_imobilier_sn_tenant_partners" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_imobilier_tenant', '=', True)]</field>
        <field name="context">{'default_is_imobilier_tenant': True, 'default_customer_rank': 1}</field>
    </record>

    <record id="action_imobilier_sn_owner_partners" model="ir.actions.act_window">
        <field name="name">Fournisseurs</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_imobilier_owner', '=', True)]</field>
        <field name="context">{'default_is_imobilier_owner': True, 'default_supplier_rank': 1}</field>
    </record>
</odoo>
