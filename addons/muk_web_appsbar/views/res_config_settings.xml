<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_res_config_settings_form_muk_appsbar" model="ir.ui.view">
        <field name="name">res.config.settings.form.muk.appsbar</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='inter_company']" position="before">
                <setting string="AppsBar" company_dependent="1" help="Logo affiché en bas de la barre des applications">
                    <div class="w-50 row"><field name="appbar_image" widget="image" class="oe_avatar"/></div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
