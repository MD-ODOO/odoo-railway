<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_paie_senegal_salary_simulation_list" model="ir.ui.view">
        <field name="name">paie.senegal.salary.simulation.list</field>
        <field name="model">paie.senegal.salary.simulation</field>
        <field name="arch" type="xml">
            <list string="Paie Sénégal Simulation">
                <field name="name"/>
                <field name="candidate_name"/>
                <field name="category_id"/>
                <field name="status"/>
                <field name="net_target" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="base_salary" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="sursalaire" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="ir_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="trimf_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="ipres_rg" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="ipres_rc" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="transport" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="net_salary" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_paie_senegal_salary_simulation_form" model="ir.ui.view">
        <field name="name">paie.senegal.salary.simulation.form</field>
        <field name="model">paie.senegal.salary.simulation</field>
        <field name="arch" type="xml">
            <form string="Paie Sénégal Simulation">
                <header>
                    <button name="action_recompute" type="object" string="Recalculer" class="btn-primary"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group string="Informations de simulation">
                        <group>
                            <field name="candidate_name"/>
                            <field name="category_id"/>
                            <field name="status"/>
                            <field name="net_target"/>
                        </group>

                        <group>
                            <field name="marital"/>
                            <field name="children_count"/>
                            <field name="spouse_has_income" invisible="marital != 'married'"/>
                            <field name="part_ir" readonly="1"/>
                            <field name="trimf_persons" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Éléments de salaire"/>

                    <group>
                        <field name="base_salary" readonly="1"/>
                        <field name="sursalaire" readonly="1"/>
                        <field name="ir_amount" readonly="1"/>
                        <field name="trimf_amount" readonly="1"/>
                        <field name="ipres_rg" readonly="1"/>
                        <field name="ipres_rc" readonly="1"/>
                        <field name="transport" readonly="1"/>
                    </group>

                    <separator string="Salaire net"/>

                    <group>
                        <field name="net_salary" readonly="1"/>
                    </group>

                    <field name="currency_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_paie_senegal_salary_simulation" model="ir.actions.act_window">
        <field name="name">Paie Sénégal Simulation</field>
        <field name="res_model">paie.senegal.salary.simulation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
