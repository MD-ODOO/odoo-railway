<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_login_theme_studio" model="res.groups.privilege">
        <field name="name">Login Theme Studio</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_login_theme_viewer" model="res.groups">
        <field name="name">Login Theme Viewer</field>
        <field name="privilege_id" ref="atliis_login_theme_studio.module_category_login_theme_studio"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_login_theme_manager" model="res.groups">
        <field name="name">Login Theme Manager</field>
        <field name="privilege_id" ref="atliis_login_theme_studio.module_category_login_theme_studio"/>
        <field name="implied_ids" eval="[(4, ref('atliis_login_theme_studio.group_login_theme_viewer'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('atliis_login_theme_studio.group_login_theme_manager'))]"/>
    </record>

    <record id="rule_login_theme_viewer_company" model="ir.rule">
        <field name="name">Login themes: viewer multi-company</field>
        <field name="model_id" ref="model_login_theme"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('atliis_login_theme_studio.group_login_theme_viewer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_login_theme_manager_company" model="ir.rule">
        <field name="name">Login themes: manager multi-company</field>
        <field name="model_id" ref="model_login_theme"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('atliis_login_theme_studio.group_login_theme_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_login_theme_background_image_company" model="ir.rule">
        <field name="name">Login theme background images: parent company rule</field>
        <field name="model_id" ref="model_login_theme_background_image"/>
        <field name="domain_force">['|', ('theme_id.company_id', '=', False), ('theme_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('atliis_login_theme_studio.group_login_theme_viewer'))]"/>
    </record>
</odoo>
