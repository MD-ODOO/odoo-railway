<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="menu_login_theme_studio_root" model="ir.ui.menu">
        <field name="name">Login Studio</field>
        <field name="parent_id" ref="base.menu_administration"/>
        <field name="sequence">75</field>
        <field name="group_ids" eval="[(4, ref('atliis_login_theme_studio.group_login_theme_manager'))]"/>
        <field name="active" eval="False"/>
    </record>

    <record id="menu_login_theme" model="ir.ui.menu">
        <field name="name">Themes</field>
        <field name="parent_id" ref="atliis_login_theme_studio.menu_login_theme_studio_root"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('atliis_login_theme_studio.action_login_theme')"/>
        <field name="sequence">10</field>
        <field name="group_ids" eval="[(4, ref('atliis_login_theme_studio.group_login_theme_manager'))]"/>
        <field name="active" eval="False"/>
    </record>

    <record id="menu_login_theme_configuration" model="ir.ui.menu">
        <field name="name">Configuration</field>
        <field name="parent_id" ref="atliis_login_theme_studio.menu_login_theme_studio_root"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('atliis_login_theme_studio.action_login_theme_configuration')"/>
        <field name="sequence">20</field>
        <field name="group_ids" eval="[(4, ref('atliis_login_theme_studio.group_login_theme_manager'))]"/>
        <field name="active" eval="False"/>
    </record>
</odoo>
