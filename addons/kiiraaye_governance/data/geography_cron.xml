<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Désactivé pour que l'import des unités locales ne charge plus tout le Sénégal. -->
    <record id="ir_cron_kiiraaye_senegal_village_import" model="ir.cron">
        <field name="name">KIIRAAY - Import villages GalsenAPI</field>
        <field name="model_id" ref="base.model_res_country"/>
        <field name="state">code</field>
        <field name="code">model.action_process_senegal_village_imports()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">False</field>
        <field name="priority">10</field>
    </record>

    <!-- Initialisation ponctuelle : quartiers de Touba Mosquée uniquement, puis zones + responsables. -->
    <record id="ir_cron_kiiraaye_touba_setup" model="ir.cron">
        <field name="name">KIIRAAY - Initialiser quartiers et zones de Touba</field>
        <field name="model_id" ref="base.model_res_country"/>
        <field name="state">code</field>
        <field name="code">model.search([('code', '=', 'SN')], limit=1).action_process_touba_setup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
        <field name="priority">1</field>
    </record>
</odoo>
