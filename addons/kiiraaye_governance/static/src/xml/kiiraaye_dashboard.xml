<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="kiiraaye_governance.KiiraayeDashboard">
        <div class="kiiraaye-dashboard o_action">
            <div class="kiiraaye-dashboard__header">
                <div class="kiiraaye-dashboard__header-main">
                    <div class="kiiraaye-dashboard__eyebrow">KIIRAAYE</div>
                    <h1>Tableau de bord</h1>
                    <p>Vue descriptive des membres, sections, organisations et du référentiel géographique.</p>
                    <div class="kiiraaye-dashboard__capacity">
                        <span>Haute volumétrie</span>
                        <b>1 000 000 sections</b>
                        <b>5 000 000 membres</b>
                    </div>
                </div>
                <div class="kiiraaye-dashboard__header-actions">
                    <div t-if="state.data.company and state.data.company.id" class="kiiraaye-dashboard__company-brand">
                        <img
                            t-att-src="'/web/image/res.company/' + state.data.company.id + '/logo'"
                            class="kiiraaye-dashboard__logo"
                            t-att-alt="state.data.company.name"
                            title="Logo de la société active"
                        />
                    </div>
                    <button class="btn btn-outline-secondary" t-on-click="refresh">
                        <i class="fa fa-refresh me-1"/> Actualiser
                    </button>
                </div>
            </div>

            <div t-if="state.error" class="alert alert-danger">
                <t t-esc="state.error"/>
            </div>
            <div t-if="state.data" class="kiiraaye-dashboard__filters">
                <div class="filter-field">
                    <label>Lieu</label>
                    <select t-on-change="(ev) => this.onFilterChange('geographie_id', ev)">
                        <option value="">Tous les lieux</option>
                        <t t-foreach="state.data.filters.geographies" t-as="item" t-key="item.id">
                            <option t-att-value="item.id" t-att-selected="state.filters.geographie_id === item.id">
                                <t t-esc="item.level"/> — <t t-esc="item.name"/>
                            </option>
                        </t>
                    </select>
                </div>
                <div class="filter-field">
                    <label>Section</label>
                    <select t-on-change="(ev) => this.onFilterChange('section_id', ev)">
                        <option value="">Toutes les sections</option>
                        <t t-foreach="state.data.filters.sections" t-as="item" t-key="item.id">
                            <option t-att-value="item.id" t-att-selected="state.filters.section_id === item.id">
                                <t t-esc="item.name"/>
                            </option>
                        </t>
                    </select>
                </div>
                <div class="filter-field">
                    <label>Organisation</label>
                    <select t-on-change="(ev) => this.onFilterChange('organisation_id', ev)">
                        <option value="">Toutes les organisations</option>
                        <t t-foreach="state.data.filters.organisations" t-as="item" t-key="item.id">
                            <option t-att-value="item.id" t-att-selected="state.filters.organisation_id === item.id">
                                <t t-esc="item.name"/>
                            </option>
                        </t>
                    </select>
                </div>
            </div>

            <div t-if="state.loading" class="kiiraaye-dashboard__loading">
                <i class="fa fa-spinner fa-spin"/> Chargement des indicateurs...
            </div>

            <t t-elif="state.data">
                <div class="kiiraaye-dashboard__effectif-overview">
                    <div class="effectif-card effectif-card--national">
                        <div class="effectif-card__label">Effectif national</div>
                        <div class="effectif-card__value"><t t-esc="formatNumber(state.data.effectif.national)"/></div>
                        <div class="effectif-card__note">Membres actifs rattachés aux sections nationales</div>
                    </div>
                    <div class="effectif-card effectif-card--diaspora">
                        <div class="effectif-card__label">Effectif hors Sénégal</div>
                        <div class="effectif-card__value"><t t-esc="formatNumber(state.data.effectif.diaspora)"/></div>
                        <div class="effectif-card__note">Membres actifs rattachés aux sections diaspora</div>
                    </div>
                    <div class="effectif-card effectif-card--total">
                        <div class="effectif-card__label">Effectif total</div>
                        <div class="effectif-card__value"><t t-esc="formatNumber(state.data.effectif.total)"/></div>
                        <div class="effectif-card__note">Total dédupliqué des membres nationaux et diaspora</div>
                    </div>
                </div>

                <div class="kiiraaye-dashboard__tabs">
                    <button t-att-class="state.view === 'section' ? 'active' : ''" t-on-click="() => this.setView('section')">Sections</button>
                    <button t-att-class="state.view === 'lieu' ? 'active' : ''" t-on-click="() => this.setView('lieu')">Lieu</button>
                    <button t-att-class="state.view === 'membre' ? 'active' : ''" t-on-click="() => this.setView('membre')">Membre</button>
                    <button t-att-class="state.view === 'historique' ? 'active' : ''" t-on-click="() => this.setView('historique')">Historique électoral</button>
                </div>

                <section t-if="state.view === 'section'">
                    <div class="kiiraaye-dashboard__section-scope-tabs">
                        <button
                            t-att-class="state.sectionScope === 'national' ? 'active' : ''"
                            t-on-click="() => this.setSectionScope('national')"
                        >
                            <i class="fa fa-map-marker me-1"/> Sections nationales
                        </button>
                        <button
                            t-att-class="state.sectionScope === 'diaspora' ? 'active' : ''"
                            t-on-click="() => this.setSectionScope('diaspora')"
                        >
                            <i class="fa fa-globe me-1"/> Sections diaspora
                        </button>
                    </div>

                    <div t-if="state.sectionScope === 'national'" class="kiiraaye-dashboard__section-scope-content">
                        <div class="panel">
                            <div class="panel__title">
                                <span>Couverture nationale des sections</span>
                                <small>global administratif / couverture Kiiraay</small>
                            </div>
                            <p class="dashboard-note">
                                Les indicateurs « X / Y » présentent le nombre d'unités couvertes par Kiiraay
                                sur le nombre total d'unités présentes dans le référentiel du Sénégal.
                                Les ratios « Membres / population nationale » et « Membres / électeurs inscrits »
                                sont des indicateurs descriptifs de couverture. Ils ne constituent pas une
                                probabilité électorale ni une prévision de résultat.
                            </p>
                        </div>

                        <div class="kiiraaye-dashboard__grid kiiraaye-dashboard__grid--kpi">
                            <div class="kpi-card coverage-kpi coverage-kpi--blue">
                                <span>Régions</span>
                                <strong><t t-esc="coverageLabel(state.data.kpis.region_count, state.data.kpis.region_total)"/></strong>
                                <small><t t-esc="formatPercent(coveragePercent(state.data.kpis.region_count, state.data.kpis.region_total))"/> couvertes par Kiiraay</small>
                            </div>
                            <div class="kpi-card coverage-kpi coverage-kpi--blue">
                                <span>Départements</span>
                                <strong><t t-esc="coverageLabel(state.data.kpis.department_count, state.data.kpis.department_total)"/></strong>
                                <small><t t-esc="formatPercent(coveragePercent(state.data.kpis.department_count, state.data.kpis.department_total))"/> couverts par Kiiraay</small>
                            </div>
                            <div class="kpi-card coverage-kpi coverage-kpi--blue">
                                <span>Communes</span>
                                <strong><t t-esc="coverageLabel(state.data.kpis.commune_count, state.data.kpis.commune_total)"/></strong>
                                <small><t t-esc="formatPercent(coveragePercent(state.data.kpis.commune_count, state.data.kpis.commune_total))"/> couvertes par Kiiraay</small>
                            </div>
                            <div class="kpi-card coverage-kpi coverage-kpi--red">
                                <span>Sections</span>
                                <strong><t t-esc="formatNumber(state.data.kpis.sections)"/></strong>
                                <small><t t-esc="formatNumber(state.data.kpis.open_sections)"/> ouvertes</small>
                            </div>
                            <div class="kpi-card coverage-kpi coverage-kpi--red">
                                <span>Membres</span>
                                <strong><t t-esc="formatNumber(state.data.kpis.members)"/></strong>
                                <small>membres actifs nationaux</small>
                            </div>
                        </div>

                        <div class="kiiraaye-dashboard__grid kiiraaye-dashboard__grid--two">
                            <div class="kpi-card coverage-kpi coverage-kpi--blue">
                                <span>Membres / population nationale</span>
                                <strong>
                                    <t t-esc="formatPercent(state.data.national_reference.member_population_ratio_pct)"/>
                                </strong>
                                <small>
                                    <t t-esc="formatNumber(state.data.kpis.members)"/> membres /
                                    <t t-esc="formatNumber(state.data.national_reference.population)"/> habitants
                                </small>
                            </div>
                            <div class="kpi-card coverage-kpi coverage-kpi--red">
                                <span>Membres / électeurs inscrits</span>
                                <strong>
                                    <t t-esc="formatPercent(state.data.national_reference.member_elector_ratio_pct)"/>
                                </strong>
                                <small>
                                    <t t-esc="formatNumber(state.data.kpis.members)"/> membres /
                                    <t t-esc="formatNumber(state.data.national_reference.electors)"/> électeurs
                                </small>
                            </div>
                        </div>

                        <div class="panel">
                            <div class="panel__title">
                                <span>Sections regroupées par région</span>
                                <small>Kiiraay / global</small>
                            </div>
                            <div class="region-gap-legend">
                                <span class="region-gap-legend__item">
                                    <i class="region-gap-legend__dot region-gap-legend__dot--above"/>
                                    Au-dessus du repère
                                </span>
                                <span class="region-gap-legend__item">
                                    <i class="region-gap-legend__dot region-gap-legend__dot--near"/>
                                    Écart faible
                                </span>
                                <span class="region-gap-legend__item">
                                    <i class="region-gap-legend__dot region-gap-legend__dot--notable"/>
                                    Écart notable
                                </span>
                                <span class="region-gap-legend__item">
                                    <i class="region-gap-legend__dot region-gap-legend__dot--large"/>
                                    Écart important
                                </span>
                            </div>
                            <div class="data-table data-table--wide">
                                <div class="data-row data-row--region-head">
                                    <span>Région</span>
                                    <span>Départements</span>
                                    <span>Communes</span>
                                    <span>Sections</span>
                                    <span>Ouvertes</span>
                                    <span>Membres</span>
                                    <span>Population 2023</span>
                                    <span>Électeurs 2024</span>
                                    <span>Inscrits / pop.</span>
                                    <span>Membres / électeurs</span>
                                    <span>Écart au repère</span>
                                </div>
                                <t t-foreach="state.data.section_geography_overview" t-as="row" t-key="row.id">
                                    <div
                                        t-att-class="'data-row data-row--region coverage-row coverage-row--' + coverageClass(row.departments_occupied, row.departments) + (state.selectedRegionId === row.id ? ' region-row--selected' : '')"
                                        t-on-click="() => this.openRegionDetail(row.id)"
                                        title="Ouvrir le détail de cette région"
                                    >
                                        <span>
                                            <strong><t t-esc="row.name"/></strong>
                                            <small class="coverage-caption">
                                                <t t-esc="formatNumber(row.sections)"/> section(s) rattachée(s)
                                            </small>
                                        </span>
                                        <span>
                                            <b t-att-class="'coverage-badge coverage-badge--' + coverageClass(row.departments_occupied, row.departments)">
                                                <t t-esc="coverageLabel(row.departments_occupied, row.departments)"/>
                                            </b>
                                        </span>
                                        <span>
                                            <b t-att-class="'coverage-badge coverage-badge--' + coverageClass(row.communes_occupied, row.communes)">
                                                <t t-esc="coverageLabel(row.communes_occupied, row.communes)"/>
                                            </b>
                                        </span>
                                        <span><strong><t t-esc="formatNumber(row.sections)"/></strong></span>
                                        <span>
                                            <b t-att-class="'coverage-badge coverage-badge--' + coverageClass(row.sections_open, row.sections)">
                                                <t t-esc="coverageLabel(row.sections_open, row.sections)"/>
                                            </b>
                                        </span>
                                        <span><strong><t t-esc="formatNumber(row.members)"/></strong></span>
                                        <span><t t-esc="formatNumber(row.population)"/></span>
                                        <span><t t-esc="formatNumber(row.electors)"/></span>
                                        <span>
                                            <b class="ratio-badge ratio-badge--reference">
                                                <t t-esc="formatPercent(row.electoral_ratio_pct)"/>
                                            </b>
                                        </span>
                                        <span>
                                            <b t-att-class="'ratio-badge ratio-badge--' + memberElectorGapClass(row)">
                                                <t t-esc="formatPercent(row.member_elector_ratio_pct)"/>
                                            </b>
                                        </span>
                                        <span>
                                            <b t-att-class="'gap-badge gap-badge--' + memberElectorGapClass(row)">
                                                <t t-esc="formatPercent(memberElectorGap(row))"/>
                                            </b>
                                            <small class="gap-caption">
                                                <t t-esc="memberElectorGapLabel(row)"/>
                                            </small>
                                        </span>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <div class="panel">
                            <div class="panel__title">
                                <span>Détail régional</span>
                                <small>lecture verticale : région → département → commune</small>
                            </div>
                            <div class="region-details region-details--vertical">
                                <t t-foreach="state.data.section_geography_overview" t-as="region" t-key="'vertical-' + region.id">
                                    <details
                                        t-att-id="'kiiraaye-region-detail-' + region.id"
                                        t-att-class="'region-details__item region-details__item--' + coverageClass(region.departments_occupied, region.departments) + (state.selectedRegionId === region.id ? ' region-details__item--selected' : '')"
                                    >
                                        <summary>
                                            <span class="region-details__name"><t t-esc="region.name"/></span>
                                            <span class="region-details__meta">
                                                Coordonnateur
                                                <b><t t-esc="region.coordinator || 'Non renseigné'"/></b>
                                                · Départements
                                                <b><t t-esc="coverageLabel(region.departments_occupied, region.departments)"/></b>
                                                · Communes
                                                <b><t t-esc="coverageLabel(region.communes_occupied, region.communes)"/></b>
                                                · Sections
                                                <b><t t-esc="formatNumber(region.sections)"/></b>
                                                · Membres
                                                <b><t t-esc="formatNumber(region.members)"/></b>
                                            </span>
                                        </summary>

                                        <div class="region-details__content">
                                            <div class="region-indicators">
                                                <div>
                                                    <span>Départements couverts</span>
                                                    <b t-att-class="'coverage-number coverage-number--' + coverageClass(region.departments_occupied, region.departments)">
                                                        <t t-esc="coverageLabel(region.departments_occupied, region.departments)"/>
                                                    </b>
                                                </div>
                                                <div>
                                                    <span>Communes couvertes</span>
                                                    <b t-att-class="'coverage-number coverage-number--' + coverageClass(region.communes_occupied, region.communes)">
                                                        <t t-esc="coverageLabel(region.communes_occupied, region.communes)"/>
                                                    </b>
                                                </div>
                                                <div><span>Sections</span><b><t t-esc="formatNumber(region.sections)"/></b></div>
                                                <div>
                                                    <span>Membres / électeurs</span>
                                                    <b t-att-class="'ratio-badge ratio-badge--' + memberElectorGapClass(region)">
                                                        <t t-esc="formatPercent(region.member_elector_ratio_pct)"/>
                                                    </b>
                                                </div>
                                                <div>
                                                    <span>Inscrits / population</span>
                                                    <b class="ratio-badge ratio-badge--reference">
                                                        <t t-esc="formatPercent(region.electoral_ratio_pct)"/>
                                                    </b>
                                                </div>
                                                <div>
                                                    <span>Écart au repère</span>
                                                    <b t-att-class="'gap-badge gap-badge--' + memberElectorGapClass(region)">
                                                        <t t-esc="formatPercent(memberElectorGap(region))"/>
                                                    </b>
                                                </div>
                                                <div><span>Membres</span><b><t t-esc="formatNumber(region.members)"/></b></div>
                                                <div class="region-indicator--coordinator">
                                                    <span>Coordonnateur régional</span>
                                                    <b><t t-esc="region.coordinator || 'Non renseigné'"/></b>
                                                </div>
                                            </div>

                                            <div class="region-detail-note">
                                                Lecture descriptive : « Membres / électeurs » est comparé au repère
                                                « Inscrits / population ». Le niveau d'écart signale uniquement
                                                une différence entre ces deux ratios et ne constitue pas une probabilité
                                                de victoire ni une prévision électorale.
                                            </div>

                                            <div class="department-stack">
                                                <t t-foreach="region.departments_rows" t-as="department" t-key="'dep-' + department.id">
                                                    <div
                                                        t-att-id="'kiiraaye-department-detail-' + region.id + '-' + department.id"
                                                        class="department-card department-card--clickable"
                                                        t-on-click="() => this.openDepartmentDetail(region.id, department.id)"
                                                        title="Voir le détail du département"
                                                    >
                                                        <div class="department-card__header">
                                                            <div>
                                                                <strong><t t-esc="department.name"/></strong>
                                                                <span><t t-esc="formatNumber(department.members)"/> membres</span>
                                                            </div>
                                                            <div class="department-card__badges">
                                                                <b t-att-class="'coverage-badge coverage-badge--' + coverageClass(
                                                                    department.communes_occupied,
                                                                    department.communes
                                                                )">
                                                                    <t t-esc="coverageLabel(department.communes_occupied, department.communes)"/> communes
                                                                </b>
                                                                <b t-att-class="'coverage-badge coverage-badge--' + coverageClass(
                                                                    department.sections_open,
                                                                    department.sections
                                                                )">
                                                                    <t t-esc="coverageLabel(department.sections_open, department.sections)"/> sections
                                                                </b>
                                                            </div>
                                                        </div>

                                                        <div class="department-card__body">
                                                            <t t-if="department.commune_rows">
                                                                <t t-foreach="department.commune_rows" t-as="commune" t-key="'comm-' + commune.id">
                                                                    <div
                                                                        t-att-id="'kiiraaye-commune-detail-' + region.id + '-' + department.id + '-' + commune.id"
                                                                        class="commune-card commune-card--clickable"
                                                                        t-on-click="() => this.openCommuneDetail(region.id, department.id, commune.id)"
                                                                        title="Voir le détail de la commune"
                                                                    >
                                                                        <span class="commune-card__name">↳ <t t-esc="commune.name"/></span>
                                                                        <span><t t-esc="formatNumber(commune.sections)"/> sections</span>
                                                                        <span><t t-esc="formatNumber(commune.sections_open)"/> ouvertes</span>
                                                                        <strong><t t-esc="formatNumber(commune.members)"/> membres</strong>
                                                                    </div>
                                                                </t>
                                                            </t>
                                                            <t t-else="">
                                                                <div class="commune-card commune-card--empty">Aucune commune couverte par une section dans ce département.</div>
                                                            </t>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>
                                    </details>
                                </t>
                            </div>
                        </div>
                    </div>

                    <div t-else="" class="kiiraaye-dashboard__section-scope-content">
                        <div class="panel">
                            <div class="panel__title">
                                <span>Sections diaspora</span>
                                <small>hors Sénégal</small>
                            </div>
                            <p class="dashboard-note">
                                Cette vue présente les sections de type diaspora, regroupées par pays,
                                ainsi que l'effectif des membres qui leur sont rattachés.
                            </p>
                        </div>

                        <div class="kiiraaye-dashboard__grid kiiraaye-dashboard__grid--kpi">
                            <div class="kpi-card coverage-kpi coverage-kpi--red">
                                <span>Pays couverts</span>
                                <strong><t t-esc="formatNumber(state.data.diaspora.countries_covered)"/></strong>
                                <small>pays avec au moins une section diaspora</small>
                            </div>
                            <div class="kpi-card coverage-kpi coverage-kpi--red">
                                <span>Sections diaspora</span>
                                <strong><t t-esc="formatNumber(state.data.kpis.sections)"/></strong>
                                <small><t t-esc="formatNumber(state.data.kpis.open_sections)"/> ouvertes</small>
                            </div>
                            <div class="kpi-card coverage-kpi coverage-kpi--blue">
                                <span>Membres hors Sénégal</span>
                                <strong><t t-esc="formatNumber(state.data.effectif.diaspora)"/></strong>
                                <small>effectif diaspora</small>
                            </div>
                        </div>

                        <div class="panel">
                            <div class="panel__title">
                                <span>Répartition des sections diaspora par pays</span>
                                <small>membres inscrits / sections</small>
                            </div>
                            <div class="data-table">
                                <div class="data-row data-row--diaspora-head">
                                    <span>Pays</span>
                                    <span>Sections</span>
                                    <span>Membres</span>
                                    <span>Part de l'effectif diaspora</span>
                                </div>
                                <t t-foreach="state.data.diaspora.countries" t-as="country" t-key="country.id">
                                    <div class="data-row data-row--diaspora">
                                        <span><strong><t t-esc="country.name"/></strong></span>
                                        <span><t t-esc="formatNumber(country.sections)"/></span>
                                        <span>
                                            <b class="coverage-badge coverage-badge--high"><t t-esc="formatNumber(country.members)"/></b>
                                        </span>
                                        <span>
                                            <t t-esc="formatPercent(
                                                state.data.effectif.diaspora
                                                    ? (country.members / state.data.effectif.diaspora) * 100
                                                    : 0
                                            )"/>
                                        </span>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </section>

                <section t-if="state.view === 'lieu'">
                    <div class="kiiraaye-dashboard__grid kiiraaye-dashboard__grid--two">
                        <div class="panel">
                            <div class="panel__title"><span>Répartition du référentiel géographique</span></div>
                            <div class="bars">
                                <t t-foreach="state.data.geography_levels" t-as="item" t-key="item.label">
                                    <div class="bar-row">
                                        <span><t t-esc="item.label"/></span>
                                        <div class="bar"><i t-att-style="'width:' + barWidth(item.value, maxGeographyValue) + '%;'"/></div>
                                        <b><t t-esc="item.value"/></b>
                                    </div>
                                </t>
                            </div>
                        </div>
                        <div class="panel callout">
                            <div class="panel__title"><span>Lecture du lieu</span></div>
                            <p>Utilisez cette vue pour contrôler la couverture du référentiel et le rattachement des sections à la hiérarchie géographique.</p>
                            <div class="mini-stat"><span>Zones actives</span><b><t t-esc="formatNumber(state.data.kpis.geographies)"/></b></div>
                            <div class="mini-stat"><span>Sections rattachées</span><b><t t-esc="formatNumber(state.data.kpis.sections)"/></b></div>
                            <div class="mini-stat"><span>Zones analysées sans section</span><b><t t-esc="formatNumber(state.data.kpis.zones_without_sections)"/></b></div>
                        </div>
                    </div>
                        <div class="panel">
                            <div class="panel__title"><span>Zones et couverture organisationnelle</span><small>lecture descriptive</small></div>
                            <div class="data-table">
                                <div class="data-row data-row--geo-head"><span>Zone</span><span>Niveau</span><span>Sections</span><span>Membres</span></div>
                                <t t-foreach="state.data.geography_rows" t-as="row" t-key="row.id">
                                    <div class="data-row data-row--geo">
                                        <span><t t-esc="row.name"/></span>
                                        <span><t t-esc="row.level"/></span>
                                        <span><t t-esc="formatNumber(row.sections)"/></span>
                                        <span><strong><t t-esc="formatNumber(row.members)"/></strong></span>
                                    </div>
                                </t>
                            </div>
                        </div>
                </section>

                <section t-if="state.view === 'membre'" >
                    <div class="kiiraaye-dashboard__grid kiiraaye-dashboard__grid--kpi">
                        <div class="kpi-card"><span>Total membres</span><strong><t t-esc="formatNumber(state.data.member_state.total)"/></strong></div>
                        <div class="kpi-card"><span>Actifs</span><strong><t t-esc="formatNumber(state.data.member_state.actifs)"/></strong></div>
                        <div class="kpi-card"><span>Inactifs</span><strong><t t-esc="formatNumber(state.data.member_state.inactifs)"/></strong></div>
                    </div>

                    <div class="panel">
                        <div class="panel__title">
                            <span>Créations de membres — 12 derniers mois</span>
                            <small>évolution descriptive</small>
                        </div>
                        <div class="bars bars--large">
                            <t t-foreach="state.data.member_creation" t-as="item" t-key="item.label">
                                <div class="bar-column">
                                    <div class="bar-value"><t t-esc="item.value"/></div>
                                    <div class="bar-vertical"><i t-att-style="'height:' + barWidth(item.value, maxCreationValue) + '%;'"/></div>
                                    <small><t t-esc="item.label"/></small>
                                </div>
                            </t>
                        </div>
                    </div>

                    <div class="panel">
                        <div class="panel__title">
                            <span>Projection d'effectif</span>
                            <small><t t-esc="state.data.projection_type"/></small>
                        </div>
                        <div class="bars bars--large">
                            <t t-foreach="state.data.member_projection" t-as="item" t-key="item.label">
                                <div class="bar-column">
                                    <div class="bar-value"><t t-esc="item.value"/></div>
                                    <div class="bar-vertical bar-vertical--projection"><i t-att-style="'height:' + barWidth(item.value, maxProjectionValue) + '%;'"/></div>
                                    <small><t t-esc="item.label"/></small>
                                </div>
                            </t>
                        </div>
                        <div class="callout">
                            Cette projection porte sur l'évolution de l'effectif des membres, pas sur un résultat électoral.
                        </div>
                    </div>
                </section>

                <section t-if="state.view === 'historique'">
                    <div class="panel">
                        <div class="panel__title"><span>Historique électoral</span></div>
                        <div class="empty-state">
                            <i class="fa fa-line-chart"/>
                            <h3>Données historiques non structurées</h3>
                            <p><t t-esc="state.data.historical_election.message"/></p>
                            <p>Le module actuel ne contient pas encore un modèle de résultats électoraux permettant de produire des indicateurs historiques vérifiables.</p>
                        </div>
                    </div>
                </section>
            </t>

            <div t-else="" class="alert alert-warning mt-3">
                Les indicateurs du tableau de bord ne sont pas disponibles pour le moment. Cliquez sur « Actualiser » pour réessayer.
            </div>
        </div>
    </t>
</templates>
