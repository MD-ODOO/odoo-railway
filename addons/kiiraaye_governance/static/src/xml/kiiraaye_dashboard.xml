<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="kiiraaye_governance.KiiraayeDashboard">
        <div class="kiiraaye-dashboard o_action">
            <div class="kiiraaye-dashboard__header">
                <div class="kiiraaye-dashboard__header-main">
                    <div class="kiiraaye-dashboard__eyebrow">KIIRAAYE</div>
                    <h1>Tableau de bord</h1>
                    <p>Vue descriptive des membres, sections, organisations et du référentiel géographique.</p>
                    <div class="kiiraaye-dashboard__capacity">
                        <span>Haute volumétrie</span>
                        <b>1 000 000 sections</b>
                        <b>5 000 000 membres</b>
                    </div>
                </div>
                <div class="kiiraaye-dashboard__header-actions">
                    <div t-if="state.data.company and state.data.company.id" class="kiiraaye-dashboard__company-brand">
                        <img
                            t-att-src="'/web/image/res.company/' + state.data.company.id + '/logo'"
                            class="kiiraaye-dashboard__logo"
                            t-att-alt="state.data.company.name"
                            title="Logo de la société active"
                        />
                    </div>
                    <button class="btn btn-outline-secondary" t-on-click="refresh">
                        <i class="fa fa-refresh me-1"/> Actualiser
                    </button>
                </div>
            </div>

            <div t-if="state.error" class="alert alert-danger">
                <t t-esc="state.error"/>
            </div>
            <div t-if="state.data" class="kiiraaye-dashboard__filters">
                <div class="filter-field">
                    <label>Lieu</label>
                    <select t-on-change="(ev) => this.onFilterChange('geographie_id', ev)">
                        <option value="">Tous les lieux</option>
                        <t t-foreach="state.data.filters.geographies" t-as="item" t-key="item.id">
                            <option t-att-value="item.id" t-att-selected="state.filters.geographie_id === item.id">
                                <t t-esc="item.level"/> — <t t-esc="item.name"/>
                            </option>
                        </t>
                    </select>
                </div>
                <div class="filter-field">
                    <label>Section</label>
                    <select t-on-change="(ev) => this.onFilterChange('section_id', ev)">
                        <option value="">Toutes les sections</option>
                        <t t-foreach="state.data.filters.sections" t-as="item" t-key="item.id">
                            <option t-att-value="item.id" t-att-selected="state.filters.section_id === item.id">
                                <t t-esc="item.name"/>
                            </option>
                        </t>
                    </select>
                </div>
                <div class="filter-field">
                    <label>Organisation</label>
                    <select t-on-change="(ev) => this.onFilterChange('organisation_id', ev)">
                        <option value="">Toutes les organisations</option>
                        <t t-foreach="state.data.filters.organisations" t-as="item" t-key="item.id">
                            <option t-att-value="item.id" t-att-selected="state.filters.organisation_id === item.id">
                                <t t-esc="item.name"/>
                            </option>
                        </t>
                    </select>
                </div>
            </div>

            <div t-if="state.loading" class="kiiraaye-dashboard__loading">
                <i class="fa fa-spinner fa-spin"/> Chargement des indicateurs...
            </div>

            <t t-elif="state.data">
                <div class="kiiraaye-dashboard__tabs">
                    <button t-att-class="state.view === 'global' ? 'active' : ''" t-on-click="() => this.setView('global')">Global</button>
                    <button t-att-class="state.view === 'section' ? 'active' : ''" t-on-click="() => this.setView('section')">Section</button>
                    <button t-att-class="state.view === 'lieu' ? 'active' : ''" t-on-click="() => this.setView('lieu')">Lieu</button>
                    <button t-att-class="state.view === 'membre' ? 'active' : ''" t-on-click="() => this.setView('membre')">Membre</button>
                    <button t-att-class="state.view === 'historique' ? 'active' : ''" t-on-click="() => this.setView('historique')">Historique électoral</button>
                </div>

                <section t-if="state.view === 'global'">
                    <div class="kiiraaye-dashboard__grid kiiraaye-dashboard__grid--kpi">
                        <div class="kpi-card"><span>Membres actifs</span><strong><t t-esc="formatNumber(state.data.kpis.members)"/></strong><small>selon le périmètre courant</small></div>
                        <div class="kpi-card"><span>Sections</span><strong><t t-esc="formatNumber(state.data.kpis.sections)"/></strong><small><t t-esc="formatNumber(state.data.kpis.open_sections)"/> ouvertes</small></div>
                        <div class="kpi-card"><span>Organisations</span><strong><t t-esc="formatNumber(state.data.kpis.organisations)"/></strong><small>structures actives</small></div>
                        <div class="kpi-card"><span>Zones géographiques</span><strong><t t-esc="formatNumber(state.data.kpis.geographies)"/></strong><small>référentiel actif</small></div>
                        <div class="kpi-card"><span>Moyenne membres / section</span><strong><t t-esc="formatNumber(state.data.kpis.avg_members_per_section)"/></strong><small>sur le périmètre courant</small></div>
                    </div>

                    <div class="kiiraaye-dashboard__grid kiiraaye-dashboard__grid--two">
                        <div class="panel">
                            <div class="panel__title"><span>Statuts d'effectif des sections</span></div>
                            <div class="bars">
                                <t t-foreach="state.data.section_statuses" t-as="item" t-key="item.label">
                                    <div class="bar-row">
                                        <span><t t-esc="item.label"/></span>
                                        <div class="bar"><i t-att-style="'width:' + barWidth(item.value, maxSectionStatus) + '%;'"/></div>
                                        <b><t t-esc="item.value"/></b>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <div class="panel">
                            <div class="panel__title"><span>Statuts d'effectif des organisations</span></div>
                            <div class="bars">
                                <t t-foreach="state.data.organisation_statuses" t-as="item" t-key="item.label">
                                    <div class="bar-row">
                                        <span><t t-esc="item.label"/></span>
                                        <div class="bar"><i t-att-style="'width:' + barWidth(item.value, maxOrganisationStatus) + '%;'"/></div>
                                        <b><t t-esc="item.value"/></b>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </section>

                <section t-if="state.view === 'section'">
                    <div class="panel">
                        <div class="panel__title">
                            <span>Vue territoriale des sections</span>
                            <small>Région → département → commune</small>
                        </div>
                        <p class="dashboard-note">
                            Les effectifs de membres sont calculés à partir des membres actifs enregistrés.
                            Les données démographiques proviennent de l'ANSD (RGPH-5 2023).
                            Les électeurs inscrits proviennent de la carte électorale DGE 2024.
                            Le ratio « inscrits / population » est un indicateur de référence calculé,
                            et non un taux officiel de participation électorale.
                        </p>
                    </div>

                    <div class="kiiraaye-dashboard__grid kiiraaye-dashboard__grid--kpi">
                        <div class="kpi-card">
                            <span>Régions</span>
                            <strong><t t-esc="formatNumber(state.data.kpis.region_count)"/></strong>
                            <small>dans le référentiel</small>
                        </div>
                        <div class="kpi-card">
                            <span>Départements</span>
                            <strong><t t-esc="formatNumber(state.data.kpis.department_count)"/></strong>
                            <small>rattachés aux régions</small>
                        </div>
                        <div class="kpi-card">
                            <span>Communes</span>
                            <strong><t t-esc="formatNumber(state.data.kpis.commune_count)"/></strong>
                            <small>rattachées aux départements</small>
                        </div>
                        <div class="kpi-card">
                            <span>Sections ouvertes</span>
                            <strong><t t-esc="formatNumber(state.data.kpis.open_sections)"/></strong>
                            <small>dans le périmètre actif</small>
                        </div>
                        <div class="kpi-card">
                            <span>Membres actifs</span>
                            <strong><t t-esc="formatNumber(state.data.kpis.members)"/></strong>
                            <small>enregistrés</small>
                        </div>
                    </div>

                    <div class="panel">
                        <div class="panel__title">
                            <span>Sections regroupées par région</span>
                            <small>lecture synthétique</small>
                        </div>
                        <div class="data-table data-table--wide">
                            <div class="data-row data-row--region-head">
                                <span>Région</span>
                                <span>Départements</span>
                                <span>Communes</span>
                                <span>Sections</span>
                                <span>Ouvertes</span>
                                <span>Membres</span>
                                <span>Population 2023</span>
                                <span>Électeurs 2024</span>
                                <span>Inscrits / pop.</span>
                                <span>Membres / électeurs</span>
                            </div>
                            <t t-foreach="state.data.section_geography_overview" t-as="row" t-key="row.id">
                                <div class="data-row data-row--region">
                                    <span><strong><t t-esc="row.name"/></strong></span>
                                    <span><t t-esc="formatNumber(row.departments)"/></span>
                                    <span><t t-esc="formatNumber(row.communes)"/></span>
                                    <span><t t-esc="formatNumber(row.sections)"/></span>
                                    <span><t t-esc="formatNumber(row.sections_open)"/></span>
                                    <span><strong><t t-esc="formatNumber(row.members)"/></strong></span>
                                    <span><t t-esc="formatNumber(row.population)"/></span>
                                    <span><t t-esc="formatNumber(row.electors)"/></span>
                                    <span><t t-esc="formatPercent(row.electoral_ratio_pct)"/></span>
                                    <span><t t-esc="formatPercent(row.member_elector_ratio_pct)"/></span>
                                </div>
                            </t>
                        </div>
                    </div>

                    <div class="panel">
                        <div class="panel__title">
                            <span>Détail régional des sections</span>
                            <small>ouvrez une région pour afficher ses départements et communes</small>
                        </div>
                        <div class="region-details">
                            <t t-foreach="state.data.section_geography_overview" t-as="region" t-key="'details-' + region.id">
                                <details class="region-details__item">
                                    <summary>
                                        <span class="region-details__name"><t t-esc="region.name"/></span>
                                        <span class="region-details__meta">
                                            <b><t t-esc="formatNumber(region.sections_open)"/></b> ouvertes /
                                            <b><t t-esc="formatNumber(region.sections)"/></b> sections ·
                                            <b><t t-esc="formatNumber(region.members)"/></b> membres
                                        </span>
                                    </summary>

                                    <div class="region-details__content">
                                        <div class="region-indicators">
                                            <div><span>Population 2023</span><b><t t-esc="formatNumber(region.population)"/></b></div>
                                            <div><span>Électeurs inscrits 2024</span><b><t t-esc="formatNumber(region.electors)"/></b></div>
                                            <div><span>Inscrits / population</span><b><t t-esc="formatPercent(region.electoral_ratio_pct)"/></b></div>
                                            <div><span>Membres / électeurs</span><b><t t-esc="formatPercent(region.member_elector_ratio_pct)"/></b></div>
                                        </div>

                                        <div class="subtable">
                                            <div class="subtable__head">
                                                <span>Département</span>
                                                <span>Communes</span>
                                                <span>Sections</span>
                                                <span>Ouvertes</span>
                                                <span>Membres</span>
                                            </div>
                                            <t t-foreach="region.departments_rows" t-as="department" t-key="department.id">
                                                <div class="subtable__department">
                                                    <span><strong><t t-esc="department.name"/></strong></span>
                                                    <span><t t-esc="formatNumber(department.communes)"/></span>
                                                    <span><t t-esc="formatNumber(department.sections)"/></span>
                                                    <span><t t-esc="formatNumber(department.sections_open)"/></span>
                                                    <span><strong><t t-esc="formatNumber(department.members)"/></strong></span>
                                                </div>
                                                <div class="subtable__communes">
                                                    <t t-foreach="department.commune_rows" t-as="commune" t-key="commune.id">
                                                        <div class="subtable__commune">
                                                            <span>↳ <t t-esc="commune.name"/></span>
                                                            <span><t t-esc="formatNumber(commune.sections)"/> sections</span>
                                                            <span><t t-esc="formatNumber(commune.sections_open)"/> ouvertes</span>
                                                            <span><t t-esc="formatNumber(commune.members)"/> membres</span>
                                                        </div>
                                                    </t>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </details>
                            </t>
                        </div>
                    </div>

                    <div class="kiiraaye-dashboard__grid kiiraaye-dashboard__grid--three">
                        <div class="panel">
                            <div class="panel__title"><span>10 régions — effectif membre actif</span></div>
                            <div class="rank-list">
                                <t t-foreach="state.data.top_member_geographies.regions" t-as="row" t-key="row.id">
                                    <div class="rank-row"><span><t t-esc="row.name"/></span><b><t t-esc="formatNumber(row.members)"/></b></div>
                                </t>
                            </div>
                        </div>
                        <div class="panel">
                            <div class="panel__title"><span>10 départements — effectif membre actif</span></div>
                            <div class="rank-list">
                                <t t-foreach="state.data.top_member_geographies.departments" t-as="row" t-key="row.id">
                                    <div class="rank-row"><span><t t-esc="row.name"/></span><b><t t-esc="formatNumber(row.members)"/></b></div>
                                </t>
                            </div>
                        </div>
                        <div class="panel">
                            <div class="panel__title"><span>10 communes — effectif membre actif</span></div>
                            <div class="rank-list">
                                <t t-foreach="state.data.top_member_geographies.communes" t-as="row" t-key="row.id">
                                    <div class="rank-row"><span><t t-esc="row.name"/></span><b><t t-esc="formatNumber(row.members)"/></b></div>
                                </t>
                            </div>
                        </div>
                    </div>
                </section>

                <section t-if="state.view === 'lieu'">
                    <div class="kiiraaye-dashboard__grid kiiraaye-dashboard__grid--two">
                        <div class="panel">
                            <div class="panel__title"><span>Répartition du référentiel géographique</span></div>
                            <div class="bars">
                                <t t-foreach="state.data.geography_levels" t-as="item" t-key="item.label">
                                    <div class="bar-row">
                                        <span><t t-esc="item.label"/></span>
                                        <div class="bar"><i t-att-style="'width:' + barWidth(item.value, maxGeographyValue) + '%;'"/></div>
                                        <b><t t-esc="item.value"/></b>
                                    </div>
                                </t>
                            </div>
                        </div>
                        <div class="panel callout">
                            <div class="panel__title"><span>Lecture du lieu</span></div>
                            <p>Utilisez cette vue pour contrôler la couverture du référentiel et le rattachement des sections à la hiérarchie géographique.</p>
                            <div class="mini-stat"><span>Zones actives</span><b><t t-esc="formatNumber(state.data.kpis.geographies)"/></b></div>
                            <div class="mini-stat"><span>Sections rattachées</span><b><t t-esc="formatNumber(state.data.kpis.sections)"/></b></div>
                            <div class="mini-stat"><span>Zones analysées sans section</span><b><t t-esc="formatNumber(state.data.kpis.zones_without_sections)"/></b></div>
                        </div>
                    </div>
                        <div class="panel">
                            <div class="panel__title"><span>Zones et couverture organisationnelle</span><small>lecture descriptive</small></div>
                            <div class="data-table">
                                <div class="data-row data-row--geo-head"><span>Zone</span><span>Niveau</span><span>Sections</span><span>Membres</span></div>
                                <t t-foreach="state.data.geography_rows" t-as="row" t-key="row.id">
                                    <div class="data-row data-row--geo">
                                        <span><t t-esc="row.name"/></span>
                                        <span><t t-esc="row.level"/></span>
                                        <span><t t-esc="formatNumber(row.sections)"/></span>
                                        <span><strong><t t-esc="formatNumber(row.members)"/></strong></span>
                                    </div>
                                </t>
                            </div>
                        </div>
                </section>

                <section t-if="state.view === 'membre'" >
                    <div class="kiiraaye-dashboard__grid kiiraaye-dashboard__grid--kpi">
                        <div class="kpi-card"><span>Total membres</span><strong><t t-esc="formatNumber(state.data.member_state.total)"/></strong></div>
                        <div class="kpi-card"><span>Actifs</span><strong><t t-esc="formatNumber(state.data.member_state.actifs)"/></strong></div>
                        <div class="kpi-card"><span>Inactifs</span><strong><t t-esc="formatNumber(state.data.member_state.inactifs)"/></strong></div>
                    </div>

                    <div class="panel">
                        <div class="panel__title">
                            <span>Créations de membres — 12 derniers mois</span>
                            <small>évolution descriptive</small>
                        </div>
                        <div class="bars bars--large">
                            <t t-foreach="state.data.member_creation" t-as="item" t-key="item.label">
                                <div class="bar-column">
                                    <div class="bar-value"><t t-esc="item.value"/></div>
                                    <div class="bar-vertical"><i t-att-style="'height:' + barWidth(item.value, maxCreationValue) + '%;'"/></div>
                                    <small><t t-esc="item.label"/></small>
                                </div>
                            </t>
                        </div>
                    </div>

                    <div class="panel">
                        <div class="panel__title">
                            <span>Projection d'effectif</span>
                            <small><t t-esc="state.data.projection_type"/></small>
                        </div>
                        <div class="bars bars--large">
                            <t t-foreach="state.data.member_projection" t-as="item" t-key="item.label">
                                <div class="bar-column">
                                    <div class="bar-value"><t t-esc="item.value"/></div>
                                    <div class="bar-vertical bar-vertical--projection"><i t-att-style="'height:' + barWidth(item.value, maxProjectionValue) + '%;'"/></div>
                                    <small><t t-esc="item.label"/></small>
                                </div>
                            </t>
                        </div>
                        <div class="callout">
                            Cette projection porte sur l'évolution de l'effectif des membres, pas sur un résultat électoral.
                        </div>
                    </div>
                </section>

                <section t-if="state.view === 'historique'">
                    <div class="panel">
                        <div class="panel__title"><span>Historique électoral</span></div>
                        <div class="empty-state">
                            <i class="fa fa-line-chart"/>
                            <h3>Données historiques non structurées</h3>
                            <p><t t-esc="state.data.historical_election.message"/></p>
                            <p>Le module actuel ne contient pas encore un modèle de résultats électoraux permettant de produire des indicateurs historiques vérifiables.</p>
                        </div>
                    </div>
                </section>
            </t>

            <div t-else="" class="alert alert-warning mt-3">
                Les indicateurs du tableau de bord ne sont pas disponibles pour le moment. Cliquez sur « Actualiser » pour réessayer.
            </div>
        </div>
    </t>
</templates>
