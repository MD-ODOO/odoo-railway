<?xml version="1.0" encoding="UTF-8"?><templates xml:space="preserve"><t t-name="kiiraaye_governance.KiiraayeTerritoryDashboard"><div class="o_kiiraaye_dashboard"><t t-if="state.loading"><div>Chargement...</div></t><t t-elif="!state.territory"><div class="alert alert-warning">Aucun  geographie de gestion.</div></t><t t-else=""><div class="o_kiiraaye_header"><div><h1>Kiiraaye Gouvernance</h1><div><t t-esc="state.territory.complete_name"/></div></div><b><t t-esc="state.territory.niveau"/></b></div><div class="o_kiiraaye_kpis"><div><span>Partisans actifs</span><strong><t t-esc="state.stats.m"/></strong></div><div><span>Sections</span><strong><t t-esc="state.stats.s"/></strong></div><div><span>Sections ouvertes</span><strong><t t-esc="state.stats.open"/></strong></div><div><span>Bureaux</span><strong><t t-esc="state.stats.b"/></strong></div><div><span>Bureaux complets</span><strong><t t-esc="state.stats.complete"/></strong></div><div><span>Activités</span><strong><t t-esc="state.stats.a"/></strong></div><div><span>Formations</span><strong><t t-esc="state.stats.f"/></strong></div></div><div class="o_kiiraaye_map_card"><h3>Vue géographique</h3><div class="o_kiiraaye_map_canvas"><div class="o_kiiraaye_map_center"><t t-esc="state.territory.name"/></div><t t-foreach="state.children" t-as="c" t-key="c.id"><div class="o_kiiraaye_map_node"><b><t t-esc="c.name"/></b><small><t t-esc="c.partisan_count"/> partisans · <t t-esc="c.section_count"/> sections</small></div></t></div></div><div class="o_kiiraaye_actions"><button class="btn btn-primary" t-on-click="()=>go('kiiraaye_governance.action_partisans')">Partisans</button><button class="btn btn-secondary" t-on-click="()=>go('kiiraaye_governance.action_member_cards')">Cartes</button><button class="btn btn-secondary" t-on-click="()=>go('kiiraaye_governance.action_sections')">Sections</button><button class="btn btn-secondary" t-on-click="()=>go('kiiraaye_governance.action_bureaux')">Bureaux</button></div></t></div></t></templates>
