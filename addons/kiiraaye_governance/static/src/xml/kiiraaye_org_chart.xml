<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="kiiraaye_governance.kiiraaye_org_chart_entry">
        <div class="k_org_chart_entry d-flex align-items-center position-relative">
            <a href="#"
               class="k_org_chart_card d-flex align-items-center"
               t-on-click.prevent="() => this._onOrganisationRedirect(organisation.id)">
                <div class="k_org_chart_icon d-flex align-items-center justify-content-center flex-shrink-0">
                    <i class="fa fa-sitemap" role="img" aria-label="Organisation"/>
                </div>
                <div class="k_org_chart_content flex-grow-1 min-width-0">
                    <div class="k_org_chart_name text-truncate" t-esc="organisation.name"/>
                    <div class="k_org_chart_type text-muted text-truncate">
                        <span t-esc="organisation.type_name"/>
                        <t t-if="organisation.niveau"> · Niveau <t t-esc="organisation.niveau"/></t>
                    </div>
                </div>
                <div class="k_org_chart_members text-center flex-shrink-0">
                    <strong t-esc="organisation.member_count"/>
                    <small>Membres</small>
                </div>
            </a>
        </div>
    </t>

    <t t-name="kiiraaye_governance.kiiraaye_org_chart">
        <div class="k_org_chart_wrapper">
            <t t-if="self">
                <div t-if="managers.length" class="k_org_chart_group_up">
                    <div t-if="managersMore" class="k_org_chart_more">
                        <a href="#"
                           title="Afficher tous les niveaux supérieurs"
                           t-on-click.prevent="_onMoreManagers">
                            <i class="fa fa-angle-double-up" role="img" aria-label="Plus de niveaux supérieurs"/>
                        </a>
                    </div>

                    <t t-foreach="managers" t-as="organisation" t-key="organisation.id">
                        <t t-call="kiiraaye_governance.kiiraaye_org_chart_entry"/>
                    </t>
                </div>

                <div class="k_org_chart_self">
                    <t t-call="kiiraaye_governance.kiiraaye_org_chart_entry">
                        <t t-set="organisation" t-value="self"/>
                    </t>
                </div>

                <div t-if="children.length" class="k_org_chart_group_down">
                    <t t-foreach="children" t-as="organisation" t-key="organisation.id">
                        <t t-call="kiiraaye_governance.kiiraaye_org_chart_entry"/>
                    </t>
                </div>

                <div t-if="!managers.length and !children.length" class="k_org_chart_empty">
                    Aucune organisation parente ou enfant n'est définie pour cette organisation.
                </div>
            </t>

            <div t-else="" class="k_org_chart_empty">
                Enregistrez l'organisation pour afficher sa hiérarchie.
            </div>
        </div>
    </t>

</templates>
