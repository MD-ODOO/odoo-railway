<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_kiiraaye" model="ir.module.category">
        <field name="name">Kiiraaye</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_kiiraaye_user" model="res.groups">
        <field name="name">Utilisateur Kiiraaye</field>
        <field name="category_id" ref="module_category_kiiraaye"/>
    </record>

    <record id="group_kiiraaye_manager" model="res.groups">
        <field name="name">Administrateur Kiiraaye</field>
        <field name="category_id" ref="module_category_kiiraaye"/>
        <field name="implied_ids" eval="[Command.link(ref('group_kiiraaye_user'))]"/>
    </record>
</odoo>
