<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_kiiraaye" model="ir.module.category">
        <field name="name">Kiiraaye</field>
        <field name="sequence">40</field>
    </record>

    <record id="groups_privilege_kiiraaye" model="res.groups.privilege">
        <field name="name">Kiiraaye</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="module_category_kiiraaye"/>
        <field name="description">Droits d'accès à l'application de gouvernance Kiiraaye.</field>
    </record>

    <record id="group_kiiraaye_user" model="res.groups">
        <field name="name">Utilisateur Kiiraaye</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="groups_privilege_kiiraaye"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Accès opérationnel aux sections, coordinations et membres.</field>
    </record>

    <record id="group_kiiraaye_coordinator" model="res.groups">
        <field name="name">Coordonnateur Kiiraaye</field>
        <field name="sequence">15</field>
        <field name="privilege_id" ref="groups_privilege_kiiraaye"/>
        <field name="implied_ids" eval="[Command.link(ref('group_kiiraaye_user'))]"/>
        <field name="comment">Droit de créer les membres uniquement dans la zone géographique coordonnée.</field>
    </record>

    <record id="group_kiiraaye_manager" model="res.groups">
        <field name="name">Administrateur Kiiraaye</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="groups_privilege_kiiraaye"/>
        <field name="implied_ids" eval="[Command.link(ref('group_kiiraaye_user'))]"/>
        <field name="comment">Accès complet, y compris au référentiel géographique et aux postes du bureau.</field>
    </record>
</odoo>
