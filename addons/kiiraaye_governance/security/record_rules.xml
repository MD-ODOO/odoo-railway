<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_territoire_scope" model="ir.rule">
        <field name="name">Kiiraaye - territoire géré</field>
        <field name="model_id" ref="model_kiiraaye_territoire"/>
        <field name="domain_force">[
            ('parent_path', '=like', user.kiiraaye_territoire_id.parent_path + '%')
        ]</field>
        <field name="groups" eval="[(4, ref('group_kiiraaye_coordonnateur'))]"/>
    </record>

