<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_kiiraaye_territoire_scope" model="ir.rule">
        <field name="name">Kiiraaye - territoires du périmètre utilisateur</field>
        <field name="model_id" ref="model_kiiraaye_territoire"/>
        <field name="domain_force">
            [('id', 'child_of', user.kiiraaye_territoire_id.id)]
        </field>
        <field name="groups" eval="[(4, ref('group_kiiraaye_coordonnateur'))]"/>
    </record>

