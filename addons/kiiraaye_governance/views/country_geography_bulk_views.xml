<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kiiraaye_country_list_geography_status" model="ir.ui.view">
        <field name="name">res.country.kiiraaye.list.geography.status</field>
        <field name="model">res.country</field>
        <field name="inherit_id" ref="kiiraaye_governance.view_kiiraaye_country_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='phone_code']" position="after">
                <field name="kiiraaye_geo_status"/>
                <field name="kiiraaye_geo_last_sync"/>
            </xpath>
        </field>
    </record>

    <record id="action_server_sync_kiiraaye_countries" model="ir.actions.server">
        <field name="name">Synchroniser la géographie des pays sélectionnés</field>
        <field name="model_id" ref="base.model_res_country"/>
        <field name="binding_model_id" ref="base.model_res_country"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
for country in records:
    country.action_sync_kiiraaye_geography()
        </field>
    </record>
</odoo>
