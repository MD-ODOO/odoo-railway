<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Format carte membre : dimensions entières en millimètres, compatibles Odoo 19. -->
    <record id="paperformat_kiiraaye_member_card" model="report.paperformat">
        <field name="name">Carte membre Kiiraaye</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">86</field>
        <field name="page_height">54</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">150</field>
    </record>

    <record id="action_report_kiiraaye_member_card" model="ir.actions.report">
        <field name="name">Carte de membre</field>
        <field name="model">kiiraaye.partisan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">kiiraaye_governance.report_kiiraaye_member_card</field>
        <field name="report_file">kiiraaye_governance.report_kiiraaye_member_card</field>
        <field name="print_report_name">'Carte_Membre_%s' % (object.reference or object.id)</field>
        <field name="paperformat_id" ref="paperformat_kiiraaye_member_card"/>
        <field name="binding_model_id" ref="model_kiiraaye_partisan"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_kiiraaye_member_card_html" model="ir.actions.report">
        <field name="name">Carte numérique</field>
        <field name="model">kiiraaye.partisan</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">kiiraaye_governance.report_kiiraaye_member_card</field>
        <field name="report_file">kiiraaye_governance.report_kiiraaye_member_card</field>
        <field name="binding_model_id" ref="model_kiiraaye_partisan"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_kiiraaye_member_card">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="width:86mm;height:54mm;margin:0;padding:0;background:#f7f9fc;color:#172033;font-family:'DejaVu Sans',Arial,Helvetica,sans-serif;overflow:hidden;position:relative;">

                    <!-- Filigrane logo société -->
                    <t t-if="res_company.logo">
                        <img t-att-src="image_data_uri(res_company.logo)"
                             alt="Logo"
                             style="position:absolute;left:25mm;top:9mm;width:36mm;height:36mm;object-fit:contain;opacity:.045;z-index:0;"/>
                    </t>

                    <!-- Bandeau supérieur -->
                    <div style="position:absolute;left:0;top:0;width:86mm;height:12mm;background:#111827;z-index:1;">
                        <table style="width:100%;height:100%;border-collapse:collapse;table-layout:fixed;">
                            <tr>
                                <td style="width:20mm;padding-left:5mm;vertical-align:middle;">
                                    <t t-if="res_company.logo">
                                        <img t-att-src="image_data_uri(res_company.logo)"
                                             alt="Logo"
                                             style="width:15mm;height:8mm;object-fit:contain;"/>
                                    </t>
                                </td>
                                <td style="width:42mm;vertical-align:middle;color:#ffffff;padding-left:1mm;">
                                    <div style="font-size:3.15mm;font-weight:700;line-height:1.1;letter-spacing:.12mm;">CARTE DE MEMBRE</div>
                                    <div style="font-size:1.8mm;color:#d8dee9;margin-top:.8mm;letter-spacing:.18mm;">KIIRAAYE</div>
                                </td>
                                <td style="width:24mm;text-align:right;vertical-align:middle;padding-right:4mm;">
                                    <span style="display:inline-block;padding:1.2mm 2mm;border:0.25mm solid #8b95a7;border-radius:3mm;color:#ffffff;font-size:1.65mm;font-weight:700;letter-spacing:.08mm;white-space:nowrap;">
                                        <t t-if="o.active">MEMBRE ACTIF</t>
                                        <t t-else="">MEMBRE INACTIF</t>
                                    </span>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Accent vertical -->
                    <div style="position:absolute;left:0;top:12mm;width:1.8mm;height:42mm;background:#c7a15a;z-index:1;"></div>

                    <!-- Corps : tableau sans flex pour une meilleure compatibilité PDF -->
                    <table style="position:absolute;left:4.5mm;top:15mm;width:77mm;height:32mm;border-collapse:collapse;table-layout:fixed;z-index:2;">
                        <tr>
                            <!-- Photo -->
                            <td style="width:22mm;padding:0;vertical-align:top;">
                                <div style="width:20mm;height:26mm;background:#ffffff;border:0.3mm solid #d8dee8;border-radius:1.6mm;overflow:hidden;text-align:center;">
                                    <t t-if="o.photo">
                                        <img t-att-src="image_data_uri(o.photo)"
                                             alt="Photo du membre"
                                             style="width:20mm;height:26mm;object-fit:cover;"/>
                                    </t>
                                    <t t-else="">
                                        <div style="padding-top:10mm;font-size:2mm;font-weight:700;color:#8b95a7;">PHOTO</div>
                                    </t>
                                </div>
                            </td>

                            <!-- Informations -->
                            <td style="width:37mm;padding:0 2mm 0 2.5mm;vertical-align:top;">
                                <div style="font-size:3.5mm;font-weight:700;line-height:1.15;text-transform:uppercase;max-width:34mm;word-wrap:break-word;">
                                    <t t-esc="o.nom_complet or ''"/>
                                </div>
                                <div style="font-size:1.65mm;color:#667085;margin-top:2mm;letter-spacing:.08mm;">N° MEMBRE</div>
                                <div style="font-size:2.9mm;font-weight:700;margin-top:.5mm;letter-spacing:.15mm;">
                                    <t t-esc="o.reference or ''"/>
                                </div>

                                <table style="width:100%;border-collapse:collapse;margin-top:1.8mm;font-size:1.8mm;line-height:1.35;table-layout:fixed;">
                                    <tr t-if="o.date_naissance">
                                        <td style="width:13mm;color:#667085;padding:0 .5mm 1mm 0;">Né(e) le</td>
                                        <td style="padding:0 0 1mm;font-weight:700;word-wrap:break-word;"><span t-field="o.date_naissance"/></td>
                                    </tr>
                                    <tr t-if="o.lieu_naissance">
                                        <td style="color:#667085;padding:0 .5mm 1mm 0;">Lieu</td>
                                        <td style="padding:0 0 1mm;font-weight:700;word-wrap:break-word;"><t t-esc="o.lieu_naissance"/></td>
                                    </tr>
                                    <tr t-if="o.phone">
                                        <td style="color:#667085;padding:0 .5mm 0 0;">Téléphone</td>
                                        <td style="padding:0;font-weight:700;word-wrap:break-word;"><t t-esc="o.phone"/></td>
                                    </tr>
                                </table>
                            </td>

                            <!-- QR -->
                            <td style="width:18mm;padding:0;vertical-align:top;text-align:center;">
                                <div style="width:16mm;height:16mm;background:#ffffff;border:0.3mm solid #d8dee8;border-radius:1.4mm;padding:1mm;margin:0 auto;text-align:center;">
                                    <t t-if="o.qr_code_value">
                                        <img t-att-src="'/report/barcode/QR/%s?width=240&amp;height=240&amp;quiet=0' % o.qr_code_value"
                                             alt="QR Code membre"
                                             style="width:16mm;height:16mm;display:block;"/>
                                    </t>
                                </div>
                                <div style="font-size:1.45mm;font-weight:700;line-height:1.15;color:#4b5563;margin-top:1mm;">SCANNEZ<br/>POUR VÉRIFIER</div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" style="padding-top:1.2mm;vertical-align:bottom;">
                                <div t-if="o.section_ids" style="font-size:1.55mm;color:#667085;line-height:1.3;max-width:57mm;">
                                    <span style="text-transform:uppercase;letter-spacing:.08mm;">Section / Coordination :</span>
                                    <strong style="color:#172033;margin-left:1mm;">
                                        <t t-esc="o.section_ids[0].name"/>
                                    </strong>
                                </div>
                            </td>
                            <td style="padding-top:1.2mm;text-align:center;vertical-align:bottom;">
                                <div style="font-size:1.4mm;color:#667085;">IDENTIFIANT</div>
                                <div style="font-size:1.6mm;font-weight:700;margin-top:.4mm;word-break:break-all;"><t t-esc="o.qr_code_value or ''"/></div>
                            </td>
                        </tr>
                    </table>

                    <!-- Pied de carte -->
                    <div style="position:absolute;left:4.5mm;right:4.5mm;bottom:1.5mm;font-size:1.35mm;color:#7b8494;z-index:2;">
                        <table style="width:100%;border-collapse:collapse;table-layout:fixed;">
                            <tr>
                                <td style="text-align:left;padding:0;">Carte numérique officielle</td>
                                <td style="text-align:right;padding:0;">
                                    <t t-if="res_company.phone"><t t-esc="res_company.phone"/></t>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
