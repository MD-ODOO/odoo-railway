<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kiiraaye_section_list" model="ir.ui.view">
        <field name="name">kiiraaye.section.list</field>
        <field name="model">kiiraaye.section</field>
        <field name="arch" type="xml">
            <list string="Sections / Coordinations">
                <field name="reference"/>
                <field name="name"/>
                <field name="type_section"/>
                <field name="lieu_id"/>
                <field name="country_id"/>
                <field name="date_creation"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_kiiraaye_section_form" model="ir.ui.view">
        <field name="name">kiiraaye.section.form</field>
        <field name="model">kiiraaye.section</field>
        <field name="arch" type="xml">
            <form string="Section / Coordination">
                <header>
                    <button name="action_ouvrir" type="object" string="Ouvrir" class="btn-primary" invisible="state == 'ouverte'"/>
                    <button name="action_fermer" type="object" string="Fermer" class="btn-secondary" invisible="state == 'fermee'"/>
                    <field name="state" widget="statusbar" statusbar_visible="ouverte,fermee"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nom de la section ou coordination"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="reference" readonly="1"/>
                            <field name="date_creation"/>
                            <field name="type_section"/>
                            <field name="lieu_id"
                                   domain="[('niveau', 'in', ('commune', 'departement', 'region', 'pays'))]"
                                   options="{'no_create': True}"/>
                            <field name="country_id" readonly="1"/>
                        </group>
                        <group string="Siège / Adresse">
                            <field name="siege_country_id"/>
                            <field name="siege_state_id"/>
                            <field name="siege_geo_id" domain="[('country_id', '=', siege_country_id)]"/>
                            <div class="o_address_format">
                                <field name="siege_street" class="o_address_street" placeholder="Rue / Adresse"/>
                                <field name="siege_street2" class="o_address_street" placeholder="Complément"/>
                                <field name="siege_zip" class="o_address_zip" placeholder="Code postal"/>
                                <field name="siege_city" class="o_address_city" placeholder="Ville"/>
                            </div>
                        </group>
                    </group>
                    <group string="Fermeture" invisible="state != 'fermee'">
                        <field name="date_fermeture" readonly="1"/>
                        <field name="motif_fermeture"/>
                    </group>
                    <notebook>
                        <page string="Membres">
                            <field name="membre_ids" context="{'default_section_id': id}" widget="many2many_tags"/>
                        </page>
                        <page string="Membres du bureau">
                            <field name="poste_ids">
                                <list>
                                    <field name="bureau_id"/>
                                    <field name="position_id"/>
                                    <field name="partisan_id"/>
                                    <field name="date_debut"/>
                                    <field name="date_fin"/>
                                    <field name="state"/>
                                    <field name="pv_election_filename" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Création">
                            <group>
                                <field name="pv_creation" filename="pv_creation_filename"/>
                                <field name="photo" widget="image"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sections" model="ir.actions.act_window">
        <field name="name">Sections / Coordinations</field>
        <field name="res_model">kiiraaye.section</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
