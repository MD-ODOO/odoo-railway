<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_section_list" model="ir.ui.view">
        <field name="name">kiiraaye.section.list</field>
        <field name="model">kiiraaye.section</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="name"/>
                <field name="territoire_id"/>
                <field name="commune_id"/>
                <field name="coordonnateur_id"/>
                <field name="state"/>
                <field name="date_creation"/>
            </list>
        </field>
    </record>

    <record id="view_section_form" model="ir.ui.view">
        <field name="name">kiiraaye.section.form</field>
        <field name="model">kiiraaye.section</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_ouvrir" type="object" string="Ouvrir"
                            class="btn-primary" invisible="state == 'ouverte'"/>
                    <button name="action_fermer" type="object" string="Fermer"
                            class="btn-secondary" invisible="state == 'fermee'"/>
                    <field name="state" widget="statusbar" statusbar_visible="ouverte,fermee"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="date_creation"/>
                            <field name="territoire_id"/>
                            <field name="commune_id"/>
                        </group>
                        <group>
                            <field name="bureau_id"/>
                            <field name="coordonnateur_id" readonly="1"/>
                            <field name="date_fermeture"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Membres">
                            <field name="membre_ids">
                                <list>
                                    <field name="matricule"/>
                                    <field name="nom"/>
                                    <field name="prenom"/>
                                    <field name="poste_actuel_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fermeture">
                            <field name="motif_fermeture"/>
                        </page>
                        <page string="Documents">
                            <field name="pv_creation" filename="pv_creation_filename"/>
                            <field name="pv_creation_filename" invisible="1"/>
                            <field name="photo" widget="image"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sections" model="ir.actions.act_window">
        <field name="name">Sections</field>
        <field name="res_model">kiiraaye.section</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
