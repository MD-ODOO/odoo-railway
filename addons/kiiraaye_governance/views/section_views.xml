<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kiiraaye_section_list" model="ir.ui.view">
        <field name="name">kiiraaye.section.list</field>
        <field name="model">kiiraaye.section</field>
        <field name="arch" type="xml">
            <list string="Sections / Coordinations">
                <field name="reference"/>
                <field name="name"/>
                <field name="type_section"/>
                <field name="country_id"/>
                <field name="region_id"/>
                <field name="departement_id"/>
                <field name="commune_id"/>
                <field name="quartier_id"/>
                <field name="date_creation"/>
                <field name="member_count" string="Membres"/>
                <field name="member_status_id" string="Statut d'effectif"/>
                <field name="state"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_kiiraaye_section_search" model="ir.ui.view">
        <field name="name">kiiraaye.section.search</field>
        <field name="model">kiiraaye.section</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="country_id"/>
                <field name="region_id"/>
                <field name="departement_id"/>
                <field name="commune_id"/>
                <field name="quartier_id"/>
                <field name="type_section"/>
                <filter name="open" string="Ouvertes" domain="[('state', '=', 'ouverte')]"/>
                <group>
                    <filter name="groupby_type" string="Type" context="{'group_by': 'type_section'}"/>
                    <filter name="groupby_country" string="Pays" context="{'group_by': 'country_id'}"/>
                    <filter name="groupby_region" string="Région" context="{'group_by': 'region_id'}"/>
                    <filter name="groupby_departement" string="Département" context="{'group_by': 'departement_id'}"/>
                    <filter name="groupby_commune" string="Commune" context="{'group_by': 'commune_id'}"/>
                    <filter name="groupby_quartier" string="Quartier" context="{'group_by': 'quartier_id'}"/>
                    <filter name="groupby_state" string="État" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_kiiraaye_section_form" model="ir.ui.view">
        <field name="name">kiiraaye.section.form</field>
        <field name="model">kiiraaye.section</field>
        <field name="arch" type="xml">
            <form string="Section / Coordination">
                <header>
                    <button name="action_open_siege" type="object" string="Ouvrir l'adresse du siège" class="oe_highlight"/>
                    <button name="action_view_hierarchy" type="object" string="Voir la hiérarchie" icon="fa-sitemap"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <div class="oe_stat_button" role="button">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="member_count"/></span>
                                <span class="o_stat_text">Membres</span>
                            </div>
                        </div>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Effectif">
                            <field name="member_count" string="Nombre de membres" readonly="1"/>
                            <field name="member_status_id" string="Statut d'effectif" readonly="1"/>
                        </group>
                        <group string="Identification">
                            <field name="reference" readonly="True"/>
                            <field name="type_section"/>
                            <field name="country_id"/>
                        </group>
                        <group string="Localisation géographique">
                            <!-- Hiérarchie ascendante : Région → Département → Commune → Quartier -->
                            <field name="region_id"
                                   invisible="type_section not in ['regionale', 'departementale', 'communale']"
                                   domain="[('country_id', '=', country_id), ('niveau', '=', 'niveau1'), ('active', '=', True)]"/>
                            <field name="departement_id"
                                   invisible="type_section not in ['departementale', 'communale']"
                                   domain="[('country_id', '=', country_id), ('niveau', '=', 'niveau2'), ('parent_id', '=', region_id), ('active', '=', True)]"/>
                            <field name="commune_id"
                                   invisible="type_section != 'communale'"
                                   domain="[('country_id', '=', country_id), ('niveau', '=', 'niveau3'), ('parent_id', '=', departement_id), ('active', '=', True)]"/>
                            <field name="quartier_id"
                                   string="Quartier"
                                   invisible="type_section != 'communale'"
                                   required="type_section == 'communale'"
                                   domain="[('country_id', '=', country_id), ('niveau', '=', 'niveau5'), ('parent_id', '=', commune_id), ('active', '=', True)]"
                                   context="{'default_country_id': country_id, 'default_parent_id': commune_id, 'default_niveau': 'niveau5'}"/>
                        </group>
                    </group>
                    <group>
                        <group string="État de la structure">
                            <field name="date_creation"/>
                            <field name="state"/>
                            <field name="active"/>
                        </group>
                        <group string="Siège">
                            <field name="siege_partner_id" context="{'default_type': 'other', 'default_country_id': country_id}" domain="[('type', '=', 'other')]"/>
                            <button name="action_open_siege" type="object" string="Modifier l'adresse du siège"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Membres">
                            <field name="membre_ids" context="{'default_country_id': country_id}">
                                <list>
                                    <field name="nom_complet"/>
                                    <field name="date_naissance"/>
                                    <field name="national_id"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Membres du bureau">
                            <field name="bureau_ligne_ids" context="{'default_section_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="position_id"/>
                                    <field name="partisan_id" domain="[('id', 'in', parent.membre_ids)]"/>
                                    <field name="date_debut"/>
                                    <field name="date_fin"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kiiraaye_section" model="ir.actions.act_window">
        <field name="name">Sections / Coordinations</field>
        <field name="res_model">kiiraaye.section</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_kiiraaye_section_search"/>
        <field name="limit">1000</field>
    </record>
</odoo>
