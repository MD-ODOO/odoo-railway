<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kiiraaye_profession_list" model="ir.ui.view">
        <field name="name">kiiraaye.profession.list</field>
        <field name="model">kiiraaye.profession</field>
        <field name="arch" type="xml">
            <list string="Professions">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_kiiraaye_profession_form" model="ir.ui.view">
        <field name="name">kiiraaye.profession.form</field>
        <field name="model">kiiraaye.profession</field>
        <field name="arch" type="xml">
            <form string="Profession">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kiiraaye_profession" model="ir.actions.act_window">
        <field name="name">Professions</field>
        <field name="res_model">kiiraaye.profession</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
