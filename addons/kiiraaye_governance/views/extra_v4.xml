<?xml version="1.0" encoding="utf-8"?><odoo>
<record id="view_card_list_v4" model="ir.ui.view"><field name="name">card.list.v4</field><field name="model">kiiraaye.member.card</field><field name="arch" type="xml"><list><field name="name"/><field name="partisan_id"/><field name="section_id"/><field name="poste_id"/><field name="date_emission"/><field name="state"/></list></field></record>
<record id="view_card_form_v4" model="ir.ui.view"><field name="name">card.form.v4</field><field name="model">kiiraaye.member.card</field><field name="arch" type="xml"><form><header><button name="action_activate" type="object" string="Activer" class="btn-primary"/><button name="action_print" type="object" string="Imprimer"/><button name="action_expire" type="object" string="Expirer"/><button name="action_cancel" type="object" string="Annuler"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="partisan_id"/><field name="territoire_id" readonly="1"/><field name="section_id" readonly="1"/><field name="poste_id" readonly="1"/><field name="date_emission"/><field name="date_expiration"/><field name="qr_value" readonly="1"/><field name="photo" widget="image" readonly="1"/></group></sheet><chatter/></form></field></record>
<record id="action_member_cards" model="ir.actions.act_window"><field name="name">Cartes de membre</field><field name="res_model">kiiraaye.member.card</field><field name="view_mode">list,form</field></record>
<record id="view_geo_territoire_list" model="ir.ui.view"><field name="name">territoire.geo.list</field><field name="model">kiiraaye.territoire</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="type_niveau"/><field name="parent_id"/><field name="latitude"/><field name="longitude"/><field name="partisan_count"/><field name="section_count"/></list></field></record>
<record id="view_ind_graph_v4" model="ir.ui.view"><field name="name">indicator.graph.v4</field><field name="model">kiiraaye.indicateur</field><field name="arch" type="xml"><graph type="bar"><field name="territoire_id"/><field name="score_global" type="measure"/><field name="score_couverture" type="measure"/><field name="score_activite" type="measure"/><field name="score_continuite" type="measure"/></graph></field></record>
<record id="action_indicators_v4" model="ir.actions.act_window"><field name="name">Indicateurs</field><field name="res_model">kiiraaye.indicateur</field><field name="view_mode">list,graph</field></record>
<record id="action_territoires_v4" model="ir.actions.act_window"><field name="name">Territoires</field><field name="res_model">kiiraaye.territoire</field><field name="view_mode">list,form</field></record>
</odoo>
