<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_campaign_list" model="ir.ui.view">
        <field name="name">kiiraaye.campagne.list</field>
        <field name="model">kiiraaye.campagne</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
            </list>
        </field>
    </record>

    <record id="view_campaign_form" model="ir.ui.view">
        <field name="name">kiiraaye.campagne.form</field>
        <field name="model">kiiraaye.campagne</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="date_debut"/>
                        <field name="date_fin"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Résultats territoriaux">
                            <field name="resultat_ids">
                                <list editable="bottom">
                                    <field name="territoire_id"/>
                                    <field name="inscrits"/>
                                    <field name="votants"/>
                                    <field name="voix_parti"/>
                                    <field name="score_pct" readonly="1"/>
                                    <field name="participation_pct" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_result_list" model="ir.ui.view">
        <field name="name">kiiraaye.resultat.list</field>
        <field name="model">kiiraaye.resultat</field>
        <field name="arch" type="xml">
            <list>
                <field name="campagne_id"/>
                <field name="territoire_id"/>
                <field name="inscrits"/>
                <field name="votants"/>
                <field name="voix_parti"/>
                <field name="score_pct"/>
                <field name="participation_pct"/>
            </list>
        </field>
    </record>

    <record id="action_campaigns" model="ir.actions.act_window">
        <field name="name">Campagnes / périodes</field>
        <field name="res_model">kiiraaye.campagne</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_results" model="ir.actions.act_window">
        <field name="name">Résultats territoriaux</field>
        <field name="res_model">kiiraaye.resultat</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
