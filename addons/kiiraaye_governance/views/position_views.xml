<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kiiraaye_position_list" model="ir.ui.view">
        <field name="name">kiiraaye.position.list</field>
        <field name="model">kiiraaye.position</field>
        <field name="arch" type="xml">
            <list string="Postes">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_kiiraaye_position_form" model="ir.ui.view">
        <field name="name">kiiraaye.position.form</field>
        <field name="model">kiiraaye.position</field>
        <field name="arch" type="xml">
            <form string="Poste">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kiiraaye_position" model="ir.actions.act_window">
        <field name="name">Postes</field>
        <field name="res_model">kiiraaye.position</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
