<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kiiraaye_section_hierarchy_wizard" model="ir.ui.view">
        <field name="name">kiiraaye.section.hierarchy.wizard.form</field>
        <field name="model">kiiraaye.section.hierarchy.wizard</field>
        <field name="arch" type="xml">
            <form string="Hiérarchie de la section">
                <sheet>
                    <div class="oe_title">
                        <h2><field name="section_id" readonly="1"/></h2>
                    </div>

                    <div class="alert alert-info" role="alert">
                        Schéma de rattachement des sections / coordinations selon leur niveau territorial.
                    </div>

                    <group>
                        <group string="Rattachement hiérarchique">
                            <field name="parent_section_id" readonly="1"/>
                            <field name="parent_section_ids" widget="many2many_tags" readonly="1"/>
                            <field name="child_section_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                        <group string="Localisation">
                            <field name="country_id" readonly="1"/>
                            <field name="region_id" readonly="1"/>
                            <field name="departement_id" readonly="1"/>
                            <field name="commune_id" readonly="1"/>
                            <field name="quartier_id" readonly="1"/>
                        </group>
                    </group>

                    <div class="o_horizontal_separator">Hiérarchie des sections / coordinations</div>
                    <field name="hierarchy_html" nolabel="1" readonly="1"/>

                    <div class="o_horizontal_separator">Parcours géographique</div>
                    <div class="k_section_geography_path">
                        <span class="k_section_geography_node"><field name="country_id" readonly="1"/></span>
                        <span class="k_section_geography_arrow">→</span>
                        <span class="k_section_geography_node"><field name="region_id" readonly="1"/></span>
                        <span class="k_section_geography_arrow">→</span>
                        <span class="k_section_geography_node"><field name="departement_id" readonly="1"/></span>
                        <span class="k_section_geography_arrow">→</span>
                        <span class="k_section_geography_node"><field name="commune_id" readonly="1"/></span>
                        <span class="k_section_geography_arrow">→</span>
                        <span class="k_section_geography_node"><field name="quartier_id" readonly="1"/></span>
                    </div>

                    <footer>
                        <button string="Fermer" special="cancel" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kiiraaye_section_hierarchy" model="ir.actions.act_window">
        <field name="name">Hiérarchie des sections</field>
        <field name="res_model">kiiraaye.section.hierarchy.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_kiiraaye_section_hierarchy_wizard"/>
        <field name="target">new</field>
    </record>
</odoo>
