<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_geo_import_form" model="ir.ui.view">
        <field name="name">kiiraaye.geo.import.form</field>
        <field name="model">kiiraaye.geo.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importer une couche administrative">
                <group>
                    <field name="country_id" help="Laisser vide pour une couche mondiale lorsque la source le permet."/>
                    <field name="boundary_type"/>
                    <field name="simplified"/>
                    <field name="update_existing"/>
                </group>
                <field name="message" readonly="1" invisible="not message"/>
                <footer>
                    <button name="action_import" type="object" string="Importer" class="btn-primary"/>
                    <button string="Fermer" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_geo_import" model="ir.actions.act_window">
        <field name="name">Importer une couche administrative</field>
        <field name="res_model">kiiraaye.geo.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_geo_bootstrap" model="ir.actions.server">
        <field name="name">Initialiser les pays</field>
        <field name="model_id" ref="model_kiiraaye_geo_bootstrap"/>
        <field name="state">code</field>
        <field name="code">action = env["kiiraaye.geo.bootstrap"].create({}).action_bootstrap_countries()</field>
    </record>

    <record id="action_geo_map" model="ir.actions.client">
        <field name="name">Carte administrative mondiale</field>
        <field name="tag">kiiraaye_geo_map</field>
    </record>
</odoo>
