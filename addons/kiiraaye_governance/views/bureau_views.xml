<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kiiraaye_bureau_list" model="ir.ui.view">
        <field name="name">kiiraaye.bureau.list</field>
        <field name="model">kiiraaye.bureau</field>
        <field name="arch" type="xml">
            <list string="Bureaux">
                <field name="name"/>
                <field name="section_id" readonly="1"/>
                <field name="geographie_id" readonly="1"/>
                <field name="coordonnateur_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_kiiraaye_bureau_form" model="ir.ui.view">
        <field name="name">kiiraaye.bureau.form</field>
        <field name="model">kiiraaye.bureau</field>
        <field name="arch" type="xml">
            <form string="Bureau">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="section_id" readonly="1"/>
                        <field name="geographie_id" readonly="1"/>
                        <field name="date_creation"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Postes">
                            <field name="poste_ids">
                                <list editable="bottom">
                                    <field name="position_id"/>
                                    <field name="partisan_id"/>
                                    <field name="date_debut"/>
                                    <field name="date_fin"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_bureaux" model="ir.actions.act_window">
        <field name="name">Bureaux</field>
        <field name="res_model">kiiraaye.bureau</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
