<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kiiraaye_country_list" model="ir.ui.view">
        <field name="name">res.country.kiiraaye.list</field>
        <field name="model">res.country</field>
        <field name="arch" type="xml">
            <list string="Pays">
                <field name="name"/>
                <field name="code"/>
                <field name="phone_code"/>
            </list>
        </field>
    </record>

    <record id="view_kiiraaye_country_form" model="ir.ui.view">
        <field name="name">res.country.kiiraaye.form</field>
        <field name="model">res.country</field>
        <field name="arch" type="xml">
            <form string="Pays">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="phone_code"/>
                    </group>
                    <separator string="Référentiel géographique"/>
                    <div class="oe_button_box" name="kiiraaye_geo_action_box" invisible="code != 'SN'">
                        <button name="action_sync_kiiraaye_geography"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-refresh">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Synchroniser</span>
                                <span class="o_stat_text">Régions / Communes</span>
                            </div>
                        </button>
                        <button name="action_load_senegal_all_villages"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-map-marker">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Charger</span>
                                <span class="o_stat_text">tous les villages GalsenAPI</span>
                            </div>
                        </button>
                        <button name="action_start_voting_place_import"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-map-marker">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Importer</span>
                                <span class="o_stat_text">centres / bureaux</span>
                            </div>
                        </button>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="code != 'SN'">
                        <strong>Référentiel géographique du Sénégal</strong>
                        <div class="mt-2">
                            <field name="kiiraaye_geo_village_import_running" invisible="1"/>
                            <field name="kiiraaye_geo_village_loaded"
                                   string="Villages GalsenAPI chargés"
                                   readonly="1"/>
                            <field name="kiiraaye_geo_village_import_message"
                                   string="État de l'import"
                                   readonly="1"
                                   nolabel="1"/>
                        </div>
                        <div class="mt-2">
                            <button name="action_load_senegal_all_villages"
                                    type="object"
                                    string="Charger tous les villages GalsenAPI"
                                    class="btn btn-primary"
                                    icon="fa-map-marker"/>
                        </div>
                    </div>
                    <div class="alert alert-warning mt-2" role="alert" invisible="code != 'SN'">
                        <strong>Centres et bureaux de vote — données électorales 2024</strong>
                        <field name="kiiraaye_vote_import_running" invisible="1"/>
                        <field name="kiiraaye_vote_import_count" string="Bureaux enregistrés" readonly="1"/>
                        <field name="kiiraaye_vote_import_message" string="État de l'import" readonly="1" nolabel="1"/>
                        <button name="action_start_voting_place_import" type="object"
                                string="Lancer / relancer l'import électoral" class="btn btn-primary" icon="fa-download"/>
                    </div>
                    <notebook>
                        <page string="Géographie Kiiraaye">
                            <field name="kiiraaye_geographie_ids" domain="[('niveau', '!=', 'pays')]">
                                <list>
                                    <field name="name"/>
                                    <field name="niveau"/>
                                    <field name="designation_locale"/>
                                    <field name="parent_id"/>
                                    <field name="code"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kiiraaye_country" model="ir.actions.act_window">
        <field name="name">Pays</field>
        <field name="res_model">res.country</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(ref('view_kiiraaye_country_list'), 'list'), (ref('view_kiiraaye_country_form'), 'form')]"/>
    </record>
</odoo>
