<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_activity_list" model="ir.ui.view">
        <field name="name">kiiraaye.activite.list</field>
        <field name="model">kiiraaye.activite</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="territoire_id"/>
                <field name="activity_type"/>
                <field name="date"/>
                <field name="responsible_id"/>
            </list>
        </field>
    </record>

    <record id="view_activity_form" model="ir.ui.view">
        <field name="name">kiiraaye.activite.form</field>
        <field name="model">kiiraaye.activite</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="territoire_id"/>
                        <field name="activity_type"/>
                        <field name="date"/>
                        <field name="responsible_id"/>
                        <field name="document_id"/>
                    </group>
                    <group string="Participants">
                        <field name="participant_ids"/>
                    </group>
                    <group string="Compte rendu">
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_activities" model="ir.actions.act_window">
        <field name="name">Activités</field>
        <field name="res_model">kiiraaye.activite</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
