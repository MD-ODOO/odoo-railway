<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_list" model="ir.ui.view">
        <field name="name">kiiraaye.document.list</field>
        <field name="model">kiiraaye.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="name"/>
                <field name="document_type"/>
                <field name="date_document"/>
                <field name="geographie_id"/>
                <field name="confidential"/>
            </list>
        </field>
    </record>

    <record id="view_document_form" model="ir.ui.view">
        <field name="name">kiiraaye.document.form</field>
        <field name="model">kiiraaye.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="document_type"/>
                            <field name="date_document"/>
                            <field name="geographie_id"/>
                        </group>
                        <group>
                            <field name="partisan_id"/>
                            <field name="election_id"/>
                            <field name="confidential"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Fichier">
                        <field name="attachment" filename="attachment_filename"/>
                        <field name="attachment_filename" invisible="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_documents" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">kiiraaye.document</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
