<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kiiraaye_demo_data_wizard" model="ir.ui.view">
        <field name="name">kiiraaye.demo.data.wizard.form</field>
        <field name="model">kiiraaye.demo.data.wizard</field>
        <field name="arch" type="xml">
            <form string="Données de démonstration">
                <sheet>
                    <div class="oe_title">
                        <h2>Générer les données de démonstration</h2>
                    </div>

                    <div class="alert alert-info" role="alert">
                        <strong>Jeu de données recommandé :</strong>
                        200 sections, 1 200 membres, les cinq postes standards
                        du bureau, une organisation racine et plusieurs coordinations.
                    </div>

                    <group>
                        <group string="Volumétrie">
                            <field name="section_count"/>
                            <field name="member_count"/>
                        </group>
                        <group string="Données">
                            <field name="replace_existing"/>
                        </group>
                    </group>

                    <div class="alert alert-warning" role="alert">
                        Les membres et sections générés sont explicitement marqués comme
                        <strong>données de démonstration</strong> afin de pouvoir être supprimés
                        sans toucher aux données réelles.
                    </div>
                </sheet>

                <footer>
                    <button name="action_generate"
                            type="object"
                            string="Générer les données"
                            class="oe_highlight"
                            icon="fa-database"/>
                    <button name="action_clear"
                            type="object"
                            string="Supprimer les données de démo"
                            icon="fa-trash"/>
                    <button string="Annuler"
                            special="cancel"
                            icon="fa-times"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kiiraaye_demo_data_wizard" model="ir.actions.act_window">
        <field name="name">Données de démonstration</field>
        <field name="res_model">kiiraaye.demo.data.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_kiiraaye_demo_data_wizard"/>
        <field name="target">new</field>
    </record>
</odoo>
