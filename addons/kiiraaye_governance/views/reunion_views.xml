<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reunion_list" model="ir.ui.view">
        <field name="name">kiiraaye.reunion.list</field>
        <field name="model">kiiraaye.reunion</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="territoire_id"/>
                <field name="reunion_type"/>
                <field name="date_debut"/>
                <field name="lieu"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_reunion_form" model="ir.ui.view">
        <field name="name">kiiraaye.reunion.form</field>
        <field name="model">kiiraaye.reunion</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" type="object" string="Marquer tenue"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="territoire_id"/>
                        <field name="reunion_type"/>
                        <field name="date_debut"/>
                        <field name="date_fin"/>
                        <field name="lieu"/>
                        <field name="document_id"/>
                    </group>
                    <notebook>
                        <page string="Participants">
                            <field name="participant_ids"/>
                        </page>
                        <page string="Ordre du jour">
                            <field name="ordre_du_jour"/>
                        </page>
                        <page string="Décisions">
                            <field name="decisions"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_reunions" model="ir.actions.act_window">
        <field name="name">Réunions</field>
        <field name="res_model">kiiraaye.reunion</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
