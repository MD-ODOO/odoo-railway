<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_territoire_list" model="ir.ui.view">
        <field name="name">kiiraaye.territoire.list</field>
        <field name="model">kiiraaye.territoire</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="type_niveau"/>
                <field name="parent_id"/>
                <field name="partisan_count"/>
                <field name="section_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_territoire_form" model="ir.ui.view">
        <field name="name">kiiraaye.territoire.form</field>
        <field name="model">kiiraaye.territoire</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="type_niveau"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="date_creation"/>
                            <field name="date_fermeture"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Responsables">
                            <field name="responsable_ids"/>
                        </page>
                        <page string="Sous-territoires">
                            <field name="child_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_territoires" model="ir.actions.act_window">
        <field name="name">Territoires</field>
        <field name="res_model">kiiraaye.territoire</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
