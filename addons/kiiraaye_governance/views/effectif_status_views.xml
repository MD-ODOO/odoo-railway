<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kiiraaye_effectif_status_list" model="ir.ui.view">
        <field name="name">kiiraaye.effectif.status.list</field>
        <field name="model">kiiraaye.effectif.status</field>
        <field name="arch" type="xml">
            <list string="Statuts d'effectif">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="min_members"/>
                <field name="max_members"/>
                <field name="color"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_kiiraaye_effectif_status_form" model="ir.ui.view">
        <field name="name">kiiraaye.effectif.status.form</field>
        <field name="model">kiiraaye.effectif.status</field>
        <field name="arch" type="xml">
            <form string="Statut d'effectif">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Plage d'effectif">
                            <field name="code"/>
                            <field name="min_members"/>
                            <field name="max_members"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Présentation">
                            <field name="color"/>
                            <field name="active"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kiiraaye_effectif_status" model="ir.actions.act_window">
        <field name="name">Statuts d'effectif</field>
        <field name="res_model">kiiraaye.effectif.status</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
