<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kiiraaye_section_form_geography_config" model="ir.ui.view">
        <field name="name">kiiraaye.section.form.geography.config</field>
        <field name="model">kiiraaye.section</field>
        <field name="inherit_id" ref="kiiraaye_governance.view_kiiraaye_section_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='country_id']" position="after">
                <field name="geo_region_level" invisible="True"/>
                <field name="geo_department_level" invisible="True"/>
                <field name="geo_commune_level" invisible="True"/>
                <field name="geo_quartier_level" invisible="True"/>
                <field name="geo_region_label" invisible="True"/>
                <field name="geo_department_label" invisible="True"/>
                <field name="geo_commune_label" invisible="True"/>
                <field name="geo_quartier_label" invisible="True"/>
            </xpath>

            <xpath expr="//field[@name='region_id']/ancestor::group[1]" position="replace">
                <group string="Localisation géographique">
                    <field name="region_id"
                           string="Région / État / Province"
                           invisible="type_section not in ['regionale', 'departementale', 'communale'] or not geo_region_level"
                           domain="[('country_id', '=', country_id), ('niveau', '=', geo_region_level), ('active', '=', True)]"/>
                    <field name="departement_id"
                           string="Département / District / Comté"
                           invisible="type_section not in ['departementale', 'communale'] or not geo_department_level"
                           domain="[('country_id', '=', country_id), ('niveau', '=', geo_department_level), ('id', 'child_of', region_id), ('active', '=', True)]"/>
                    <field name="commune_id"
                           string="Commune / Municipalité / Ville"
                           invisible="type_section != 'communale' or not geo_commune_level"
                           domain="[('country_id', '=', country_id), ('niveau', '=', geo_commune_level), ('id', 'child_of', departement_id if departement_id else region_id), ('active', '=', True)]"/>
                    <field name="zone_id"
                           string="Zone"
                           invisible="type_section != 'communale'"
                           required="type_section == 'communale'"
                           domain="[('commune_id', '=', commune_id), ('active', '=', True)]"/>
                    <field name="zone_quartier_ids" invisible="1"/>
                    <field name="quartier_id"
                           string="Quartier"
                           invisible="type_section != 'communale'"
                           required="type_section == 'communale'"
                           domain="[('id', 'in', zone_quartier_ids)]"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
