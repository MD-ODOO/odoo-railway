<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kiiraaye_partisan_list" model="ir.ui.view">
        <field name="name">kiiraaye.partisan.list</field>
        <field name="model">kiiraaye.partisan</field>
        <field name="arch" type="xml">
            <list string="Membres">
                <field name="reference"/>
                <field name="nom_complet"/>
                <field name="profession_id"/>
                <field name="organisation_ids" widget="many2many_tags"/>
                <field name="ralliement_ids" widget="many2many_tags"/>
                <field name="date_naissance"/>
                <field name="national_id"/>
                <field name="country_id"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_kiiraaye_partisan_search" model="ir.ui.view">
        <field name="name">kiiraaye.partisan.search</field>
        <field name="model">kiiraaye.partisan</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="nom_complet"/>
                <field name="profession_id"/>
                <field name="organisation_ids"/>
                <field name="national_id"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="country_id"/>
                <filter name="active" string="Actifs" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="view_kiiraaye_partisan_form" model="ir.ui.view">
        <field name="name">kiiraaye.partisan.form</field>
        <field name="model">kiiraaye.partisan</field>
        <field name="arch" type="xml">
            <form string="Membre">
                <header>
                    <button name="action_view_membership_card"
                            type="object"
                            string="Carte numérique"
                            icon="fa-id-card"
                            class="oe_highlight"/>
                    <button name="action_print_membership_card"
                            type="object"
                            string="Imprimer la carte"
                            icon="fa-print"/>
                    <button name="action_open_organisation_assignment"
                            type="object"
                            string="Affecter à une organisation"
                            icon="fa-sitemap"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_membership_card"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-id-card">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Carte numérique</span>
                            </div>
                        </button>
                        <button name="action_print_membership_card"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-print">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Imprimer</span>
                            </div>
                        </button>
                        <button name="action_open_organisation_assignment"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-sitemap">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Organisation(s)</span>
                            </div>
                        </button>
                    </div>

                    <!-- Photo à gauche + bannières collées à l'extrême droite et inclinées. -->
                    <div style="display:flex;align-items:flex-start;gap:20px;margin-bottom:14px;position:relative;width:100%;">
                        <div style="width:190px;min-width:190px;height:235px;">
                            <field name="photo"
                                   widget="image"
                                   style="width:180px!important;height:225px!important;object-fit:cover;border-radius:8px;border:1px solid #d8dee8;"/>
                        </div>

                        <div style="flex:1;min-width:0;padding-top:2px;padding-right:370px;">
                            <div class="oe_title">
                                <h1><field name="nom_complet" readonly="1"/></h1>
                                <h3><field name="reference" readonly="1"/></h3>
                            </div>

                            <group string="Synthèse">
                                <field name="profession_id"
                                       string="Profession"
                                       options="{'no_create': True}"/>
                                <field name="organisation_ids"
                                       string="Organisations"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"/>
                            </group>
                        </div>

                        <!-- Rail horizontal des bannières à l'extrême droite. -->
                        <div style="position:absolute;right:0;top:8px;width:390px;display:flex;flex-direction:column;align-items:flex-end;gap:12px;">
                            <div invisible="not organisation_banner"
                                 style="width:370px;padding:9px 16px;background:#2f5597;color:#fff;font-size:11px;font-weight:700;line-height:14px;border-radius:5px;box-shadow:0 3px 7px rgba(0,0,0,.18);transform:rotate(-6deg);transform-origin:right center;text-align:left;">
                                ORGANISATION(S)
                                <div style="font-weight:600;max-height:42px;overflow:hidden;">
                                    <field name="organisation_banner" nolabel="1"/>
                                </div>
                            </div>

                            <div invisible="not poste_banner"
                                 style="width:355px;padding:9px 16px;background:#2e7d32;color:#fff;font-size:10px;font-weight:700;line-height:13px;border-radius:5px;box-shadow:0 3px 7px rgba(0,0,0,.18);transform:rotate(-6deg);transform-origin:right center;text-align:left;">
                                POSTE(S) / SECTION(S)
                                <div style="font-weight:600;max-height:56px;overflow:hidden;">
                                    <field name="poste_banner" nolabel="1"/>
                                </div>
                            </div>

                            <div invisible="not coordonnateur_banner"
                                 style="width:345px;padding:9px 16px;background:#9c27b0;color:#fff;font-size:10px;font-weight:700;line-height:13px;border-radius:5px;box-shadow:0 3px 7px rgba(0,0,0,.18);transform:rotate(-6deg);transform-origin:right center;text-align:left;">
                                COORDONNATEUR / SECTION(S)
                                <div style="font-weight:600;max-height:56px;overflow:hidden;">
                                    <field name="coordonnateur_banner" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <group string="Informations personnelles">
                        <group>
                            <field name="prenom" string="Prénom"/>
                            <field name="nom" string="Nom"/>
                            <field name="date_naissance" string="Date de naissance"/>
                            <field name="lieu_naissance" string="Lieu de naissance"/>
                        </group>
                        <group>
                            <field name="national_id" string="N° pièce d'identité"/>
                            <field name="country_id" string="Pays"/>
                            <field name="phone" string="Téléphone" widget="phone"/>
                            <field name="email" string="E-mail" widget="email"/>
                            <field name="active" string="Actif"/>
                            <field name="organisation_banner" invisible="1"/>
                            <field name="poste_banner" invisible="1"/>
                            <field name="coordonnateur_banner" invisible="1"/>
                            <field name="qr_code_value" string="Valeur QR" readonly="1" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Sections / Coordinations">
                            <field name="section_ids">
                                <list>
                                    <field name="reference"/>
                                    <field name="name"/>
                                    <field name="type_section"/>
                                    <field name="country_id"/>
                                    <field name="region_id"/>
                                    <field name="departement_id"/>
                                    <field name="commune_id"/>
                                    <field name="quartier_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <page string="Ralliements">
                            <field name="ralliement_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="type_ralliement"/>
                                    <field name="country_id"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>

                        <page string="Organisations">
                            <field name="organisation_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="type_id"/>
                                    <field name="niveau"/>
                                    <field name="parent_id"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>

                        <page string="Postes occupés">
                            <field name="attribution_poste_ids"
                                   domain="[('state', '=', 'validee')]"
                                   readonly="1">
                                <list string="Postes occupés">
                                    <field name="reference"/>
                                    <field name="position_id"/>
                                    <field name="section_id"/>
                                    <field name="date_attribution"/>
                                    <field name="pv_file" filename="pv_filename"/>
                                    <field name="validation_uid"/>
                                    <field name="validation_date"/>
                                </list>
                            </field>
                        </page>

                        <page string="Pièces jointes">
                            <field name="attachment_ids"
                                   widget="many2many_binary"
                                   string="Pièces jointes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kiiraaye_partisan" model="ir.actions.act_window">
        <field name="name">Membres</field>
        <field name="res_model">kiiraaye.partisan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_kiiraaye_partisan_search"/>
        <field name="limit">10000</field>
    </record>
</odoo>
