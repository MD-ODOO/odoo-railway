<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kiiraaye_ralliement_list" model="ir.ui.view">
        <field name="name">kiiraaye.ralliement.list</field>
        <field name="model">kiiraaye.ralliement</field>
        <field name="arch" type="xml">
            <list string="Kiiraay Ralliements">
                <field name="name"/>
                <field name="code"/>
                <field name="type_ralliement"/>
                <field name="country_id"/>
                <field name="member_count"/>
                <field name="date_creation"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_kiiraaye_ralliement_search" model="ir.ui.view">
        <field name="name">kiiraaye.ralliement.search</field>
        <field name="model">kiiraaye.ralliement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="type_ralliement"/>
                <field name="country_id"/>
                <filter name="active" string="Actifs" domain="[('active', '=', True)]"/>
                <group>
                    <filter name="groupby_type" string="Type" context="{'group_by': 'type_ralliement'}"/>
                    <filter name="groupby_country" string="Pays" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_kiiraaye_ralliement_form" model="ir.ui.view">
        <field name="name">kiiraaye.ralliement.form</field>
        <field name="model">kiiraaye.ralliement</field>
        <field name="arch" type="xml">
            <form string="Kiiraay Ralliement">
                <header>
                    <button name="action_add_members"
                            type="object"
                            string="Ajouter des membres"
                            icon="fa-user-plus"
                            class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_add_members"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="member_count"/></span>
                                <span class="o_stat_text">Membres</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>

                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="type_ralliement"/>
                            <field name="country_id" options="{'no_create': True}"/>
                            <field name="date_creation"/>
                            <field name="active"/>
                        </group>
                        <group string="Effectif">
                            <field name="member_count" readonly="1"/>
                            <field name="description"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Membres">
                            <field name="member_ids">
                                <list>
                                    <field name="reference"/>
                                    <field name="nom_complet"/>
                                    <field name="profession_id"/>
                                    <field name="section_ids" widget="many2many_tags"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kiiraaye_ralliement" model="ir.actions.act_window">
        <field name="name">Kiiraay Ralliements</field>
        <field name="res_model">kiiraaye.ralliement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_kiiraaye_ralliement_search"/>
    </record>

    <record id="view_kiiraaye_ralliement_add_members_wizard" model="ir.ui.view">
        <field name="name">kiiraaye.ralliement.add.members.wizard.form</field>
        <field name="model">kiiraaye.ralliement.add.members.wizard</field>
        <field name="arch" type="xml">
            <form string="Ajouter des membres au ralliement">
                <group>
                    <field name="ralliement_id"/>
                    <field name="member_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_add" type="object" string="Ajouter" class="oe_highlight"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kiiraaye_ralliement_add_members" model="ir.actions.act_window">
        <field name="name">Ajouter des membres</field>
        <field name="res_model">kiiraaye.ralliement.add.members.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_kiiraaye_ralliement_add_members_wizard"/>
        <field name="target">new</field>
    </record>
</odoo>
