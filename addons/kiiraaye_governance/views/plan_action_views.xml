<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_plan_action_list" model="ir.ui.view">
        <field name="name">kiiraaye.plan.action.list</field>
        <field name="model">kiiraaye.plan.action</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="geographie_id"/>
                <field name="responsible_id"/>
                <field name="priority"/>
                <field name="date_fin"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_plan_action_form" model="ir.ui.view">
        <field name="name">kiiraaye.plan.action.form</field>
        <field name="model">kiiraaye.plan.action</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Démarrer"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Terminer"
                            invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state == 'done' or state == 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="geographie_id"/>
                        <field name="responsible_id"/>
                        <field name="priority"/>
                        <field name="date_debut"/>
                        <field name="date_fin"/>
                        <field name="indicator"/>
                    </group>
                    <notebook>
                        <page string="Constat">
                            <field name="constat"/>
                        </page>
                        <page string="Action">
                            <field name="action_description"/>
                        </page>
                        <page string="Résultat">
                            <field name="result"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_plan_actions" model="ir.actions.act_window">
        <field name="name">Plans d'action</field>
        <field name="res_model">kiiraaye.plan.action</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
