<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kiiraaye_attribution_poste_search" model="ir.ui.view">
        <field name="name">kiiraaye.attribution.poste.search</field>
        <field name="model">kiiraaye.attribution.poste</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="position_id"/>
                <field name="section_id"/>
                <field name="partisan_id"/>
                <field name="date_attribution"/>
                <field name="state"/>
                <filter name="validees" string="Validées" domain="[('state', '=', 'validee')]"/>
                <filter name="brouillons" string="Brouillons" domain="[('state', '=', 'brouillon')]"/>
                <filter name="annulees" string="Annulées" domain="[('state', '=', 'annulee')]"/>
            </search>
        </field>
    </record>

    <record id="view_kiiraaye_attribution_poste_list" model="ir.ui.view">
        <field name="name">kiiraaye.attribution.poste.list</field>
        <field name="model">kiiraaye.attribution.poste</field>
        <field name="arch" type="xml">
            <list string="Attributions de postes">
                <field name="reference"/>
                <field name="position_id"/>
                <field name="section_id"/>
                <field name="partisan_id"/>
                <field name="date_attribution"/>
                <field name="state"/>
                <field name="validation_uid"/>
                <field name="validation_date"/>
            </list>
        </field>
    </record>

    <record id="view_kiiraaye_attribution_poste_form" model="ir.ui.view">
        <field name="name">kiiraaye.attribution.poste.form</field>
        <field name="model">kiiraaye.attribution.poste</field>
        <field name="arch" type="xml">
            <form string="Attribution de poste">
                <header>
                    <button name="action_validate"
                            type="object"
                            string="Valider l'attribution"
                            class="oe_highlight"
                            icon="fa-check"
                            groups="kiiraaye_governance.group_kiiraaye_manager"
                            invisible="state != 'brouillon'"/>
                    <button name="action_cancel"
                            type="object"
                            string="Annuler"
                            icon="fa-times"
                            groups="kiiraaye_governance.group_kiiraaye_manager"
                            invisible="state not in ('brouillon', 'validee')"/>
                    <field name="state" widget="statusbar" statusbar_visible="brouillon,validee,annulee"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Attribution">
                            <field name="position_id" readonly="state != 'brouillon'"/>
                            <field name="section_id" readonly="state != 'brouillon'"/>
                            <field name="partisan_id"
                                   readonly="state != 'brouillon'"
                                   domain="[('section_ids', 'in', section_id)]"/>
                            <field name="date_attribution" readonly="state != 'brouillon'"/>
                        </group>
                        <group string="Procès-verbal">
                            <field name="pv_file" filename="pv_filename" readonly="state != 'brouillon'"/>
                            <field name="pv_filename" invisible="1"/>
                            <field name="validation_uid" readonly="1"/>
                            <field name="validation_date" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="state != 'brouillon'">
                        <strong>Validation :</strong>
                        la validation crée ou réactive automatiquement le poste correspondant dans le bureau de la section.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kiiraaye_attribution_poste" model="ir.actions.act_window">
        <field name="name">Attributions de postes</field>
        <field name="res_model">kiiraaye.attribution.poste</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_kiiraaye_attribution_poste_search"/>
    </record>
</odoo>
