<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_formation_list" model="ir.ui.view">
        <field name="name">kiiraaye.formation.list</field>
        <field name="model">kiiraaye.formation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="geographie_id"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="formateur"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_formation_form" model="ir.ui.view">
        <field name="name">kiiraaye.formation.form</field>
        <field name="model">kiiraaye.formation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_plan" type="object" string="Planifier"
                            invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Terminer"
                            class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state == 'done' or state == 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,planned,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="geographie_id"/>
                        <field name="formateur"/>
                        <field name="date_debut"/>
                        <field name="date_fin"/>
                        <field name="duree_heures"/>
                        <field name="document_id"/>
                    </group>
                    <group string="Thème / programme">
                        <field name="theme"/>
                    </group>
                    <group string="Participants">
                        <field name="participant_ids"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_formations" model="ir.actions.act_window">
        <field name="name">Formations</field>
        <field name="res_model">kiiraaye.formation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
