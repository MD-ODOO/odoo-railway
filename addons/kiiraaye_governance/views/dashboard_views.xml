<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kiiraaye_dashboard_form" model="ir.ui.view">
        <field name="name">kiiraaye.dashboard.form</field>
        <field name="model">kiiraaye.dashboard</field>
        <field name="arch" type="xml">
            <form string="Tableau de bord Kiiraaye">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                    <div class="alert alert-info">
                        Le contenu des indicateurs est piloté par OWL. La personnalisation avancée des widgets sera ajoutée sur cette base.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kiiraaye_dashboard_list" model="ir.ui.view">
        <field name="name">kiiraaye.dashboard.list</field>
        <field name="model">kiiraaye.dashboard</field>
        <field name="arch" type="xml">
            <list string="Tableaux de bord">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_kiiraaye_dashboard_config" model="ir.actions.act_window">
        <field name="name">Configuration des tableaux de bord</field>
        <field name="res_model">kiiraaye.dashboard</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_kiiraaye_dashboard" model="ir.actions.client">
        <field name="name">Tableau de bord Kiiraaye</field>
        <field name="tag">kiiraaye_dashboard</field>
    </record>
</odoo>
