<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dashboard_territoire_list" model="ir.ui.view">
        <field name="name">kiiraaye.dashboard.territoire.list</field>
        <field name="model">kiiraaye.territoire</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name"/>
                <field name="type_niveau"/>
                <field name="partisan_count"/>
                <field name="section_count"/>
                <field name="bureau_id"/>
            </list>
        </field>
    </record>

    <record id="action_dashboard" model="ir.actions.act_window">
        <field name="name">Tableau de bord territorial</field>
        <field name="res_model">kiiraaye.territoire</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
