<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_member_card_list" model="ir.ui.view">
        <field name="name">kiiraaye.member.card.list</field>
        <field name="model">kiiraaye.member.card</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partisan_id"/>
                <field name="matricule" invisible="1"/>
                <field name="territoire_id"/>
                <field name="section_id"/>
                <field name="poste_id"/>
                <field name="date_emission"/>
                <field name="date_expiration"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_member_card_form" model="ir.ui.view">
        <field name="name">kiiraaye.member.card.form</field>
        <field name="model">kiiraaye.member.card</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activer"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_expire" type="object" string="Expirer"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state == 'cancelled'"/>
                    <button name="action_print" type="object" string="Imprimer"
                            class="btn-secondary" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,expired,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partisan_id"/>
                            <field name="territoire_id" readonly="1"/>
                            <field name="section_id" readonly="1"/>
                            <field name="poste_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_emission"/>
                            <field name="date_expiration"/>
                            <field name="qr_value" readonly="1"/>
                            <field name="photo" widget="image" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_member_cards" model="ir.actions.act_window">
        <field name="name">Cartes de membre</field>
        <field name="res_model">kiiraaye.member.card</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
