<?xml version="1.0" encoding="utf-8"?><odoo><template id="member_card_report"><t t-call="web.basic_layout"><t t-foreach="docs" t-as="c"><div class="page kiiraaye-card-page"><div class="kiiraaye-card"><div class="kiiraaye-card-bg" t-if="c.env.company.logo" t-att-style="'background-image:url(%s)' % image_data_uri(c.env.company.logo)"/><div class="kiiraaye-card-header"><div class="kiiraaye-brand-block"><div class="kiiraaye-logo-wrap"><img t-if="c.env.company.logo" t-att-src="image_data_uri(c.env.company.logo)" class="kiiraaye-logo"/></div><div><div class="kiiraaye-brand">KIIRAAYE</div><div class="kiiraaye-title">CARTE DE MEMBRE</div></div></div><div class="kiiraaye-ref"><t t-esc="c.name"/></div></div><div class="kiiraaye-card-body"><div class="kiiraaye-photo-panel"><img t-if="c.photo" t-att-src="image_data_uri(c.photo)" class="kiiraaye-member-photo"/><span t-else="">PHOTO</span></div><div><div class="kiiraaye-member-name"><t t-esc="c.partisan_id.prenom"/> <t t-esc="c.partisan_id.nom"/></div><div class="kiiraaye-line"><span class="kiiraaye-label">Matricule</span><span><t t-esc="c.partisan_id.matricule"/></span></div><div class="kiiraaye-line"><span class="kiiraaye-label">Section</span><span><t t-esc="c.section_id.name"/></span></div><div class="kiiraaye-line"><span class="kiiraaye-label">Territoire</span><span><t t-esc="c.territoire_id.complete_name"/></span></div><div class="kiiraaye-line" t-if="c.poste_id"><span class="kiiraaye-label">Fonction</span><span><t t-esc="c.poste_id.position_id.name"/></span></div></div><div><img class="kiiraaye-qr" t-att-src="'/report/barcode/?type=QR&amp;value=%s&amp;width=150&amp;height=150' % c.qr_value"/></div></div><div class="kiiraaye-card-footer">Carte personnelle — <t t-esc="c.date_emission"/></div></div></div></t></t></template><record id="action_report_member_card" model="ir.actions.report"><field name="name">Carte de membre</field><field name="model">kiiraaye.member.card</field><field name="report_type">qweb-pdf</field><field name="report_name">kiiraaye_governance.member_card_report</field><field name="report_file">kiiraaye_governance.member_card_report</field><field name="print_report_name">'Carte-%s'%object.name</field></record></odoo>
