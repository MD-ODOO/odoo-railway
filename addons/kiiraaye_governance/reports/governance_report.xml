<?xml version="1.0" encoding="utf-8"?><odoo><template id="governance_report"><t t-call="web.external_layout"><div class="page"><h1 t-esc="docs.report_title"/><p><t t-esc="docs.date_debut"/> — <t t-esc="docs.date_fin"/></p><h2>Synthèse</h2><table class="table table-sm"><tr><th>Partisans actifs</th><td t-esc="env['kiiraaye.partisan'].search_count([('active','=',True)])"/></tr><tr><th>Sections</th><td t-esc="env['kiiraaye.section'].search_count([])"/></tr><tr><th>Bureaux</th><td t-esc="env['kiiraaye.bureau'].search_count([])"/></tr></table><h2>Indicateurs territoriaux</h2><table class="table table-sm"><tr><th>Territoire</th><th>Couverture</th><th>Activité</th><th>Global</th><th>Niveau</th></tr><t t-foreach="env['kiiraaye.indicateur'].search([],order='score_global desc')" t-as="i"><tr><td t-esc="i.geographie_id.complete_name"/><td t-esc="'%.1f' % i.score_couverture"/><td t-esc="'%.1f' % i.score_activite"/><td t-esc="'%.1f' % i.score_global"/><td t-esc="i.niveau"/></tr></t></table></div></t></template><record id="action_report_governance" model="ir.actions.report"><field name="name">Rapport de gouvernance</field><field name="model">kiiraaye.national.report.wizard</field><field name="report_type">qweb-pdf</field><field name="report_name">kiiraaye_governance.governance_report</field><field name="report_file">kiiraaye_governance.governance_report</field><field name="print_report_name">'Rapport-Gouvernance-%s'%object.date_fin</field></record></odoo>
