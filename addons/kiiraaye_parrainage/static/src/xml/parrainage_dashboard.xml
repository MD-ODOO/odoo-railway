<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="kiiraayeParrainage.Dashboard">
<div class="kp-dashboard">
<div class="kp-header"><div><h1>Tableau de bord des parrainages</h1><p>Suivi national, territorial et diaspora</p></div><button class="btn btn-primary" t-on-click="openList">Voir la liste</button></div>
<div class="kp-filters"><button t-att-class="state.scope === 'all' ? 'active' : ''" t-on-click="() => setScope('all')">Tous</button><button t-att-class="state.scope === 'national' ? 'active' : ''" t-on-click="() => setScope('national')">National</button><button t-att-class="state.scope === 'diaspora' ? 'active' : ''" t-on-click="() => setScope('diaspora')">Diaspora</button></div>
<t t-if="state.loading"><div class="kp-loading">Chargement…</div></t>
<t t-else=""><div class="kp-kpis"><div class="kp-card"><span>Parrainages</span><strong t-esc="total"/></div><div class="kp-card"><span>N.I.N distincts</span><strong t-esc="distinctCni"/></div><div class="kp-card"><span>National</span><strong t-esc="national"/></div><div class="kp-card"><span>Diaspora</span><strong t-esc="diaspora"/></div></div>
<div class="kp-panel"><div class="kp-panel-title">Localités avec le plus de parrainages</div><t t-if="!state.rows.length"><div class="kp-empty">Aucune donnée</div></t><t t-foreach="state.rows.slice(0,15)" t-as="row" t-key="row.id"><div class="kp-row"><div class="kp-location"><strong t-esc="row.location_name || 'National'"/><small t-esc="[row.region_name,row.departement_name,row.commune_name].filter(Boolean).join(' · ')"/></div><div class="kp-bar"><i t-att-style="'width:' + Math.min(100,(row.parrain_count/Math.max(1,state.rows[0].parrain_count))*100) + '%'"/></div><strong class="kp-value" t-esc="row.parrain_count"/></div></t></div></t>
</div>
</t>
</templates>