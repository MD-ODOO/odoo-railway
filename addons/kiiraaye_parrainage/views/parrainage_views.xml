<odoo>
<record id="view_parrainage_tree" model="ir.ui.view"><field name="name">kiiraaye.parrainage.tree</field><field name="model">kiiraaye.parrainage</field><field name="arch" type="xml"><list string="Liste des parrainages"><field name="name"/><field name="full_name"/><field name="nin"/><field name="voter_card_number"/><field name="scope"/><field name="region_id"/><field name="departement_id"/><field name="commune_id"/><field name="quartier_id"/><field name="birth_date"/><field name="age"/><field name="birth_control_status"/></list></field></record>
<record id="view_parrainage_form" model="ir.ui.view"><field name="name">kiiraaye.parrainage.form</field><field name="model">kiiraaye.parrainage</field><field name="arch" type="xml"><form string="Parrainage"><sheet><group><group><field name="election_id"/><field name="scope"/><field name="order_number"/><field name="full_name"/><field name="nin"/><field name="voter_card_number"/></group><group><field name="birth_date"/><field name="age" readonly="1"/><field name="birth_control_status" readonly="1"/><field name="cni_expiry_date"/><field name="signature"/><field name="collection_date"/></group></group><separator string="Localisation"/><group><field name="country_id"/><field name="region_id" domain="[('niveau','=','niveau1')]"/><field name="departement_id" domain="[('niveau','=','niveau2'),('parent_id','=',region_id)]"/><field name="commune_id" domain="[('niveau','=','niveau3'),('parent_id','=',departement_id)]"/><field name="quartier_id" domain="[('niveau','in',('niveau4','niveau5','niveau6')),('parent_id','=',commune_id)]"/></group><separator string="Collecte"/><group><field name="collector_name"/><field name="collector_voter_card"/></group></sheet></form></field></record>
<record id="view_election_tree" model="ir.ui.view"><field name="name">kiiraaye.parrainage.election.tree</field><field name="model">kiiraaye.parrainage.election</field><field name="arch" type="xml"><list><field name="name"/><field name="candidate_name"/><field name="election_type"/><field name="date_start"/><field name="date_end"/><field name="national_count"/><field name="diaspora_count"/></list></field></record>
<record id="view_election_form" model="ir.ui.view"><field name="name">kiiraaye.parrainage.election.form</field><field name="model">kiiraaye.parrainage.election</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="candidate_name"/><field name="candidate_number"/><field name="election_type"/><field name="date_start"/><field name="date_end"/></group></sheet></form></field></record>
<record id="action_parrainage" model="ir.actions.act_window"><field name="name">Parrainages</field><field name="res_model">kiiraaye.parrainage</field><field name="view_mode">list,form</field></record>
<record id="action_elections" model="ir.actions.act_window"><field name="name">Campagnes</field><field name="res_model">kiiraaye.parrainage.election</field><field name="view_mode">list,form</field></record>
</odoo>