<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_smart_student_list" model="ir.ui.view"><field name="name">smart.student.list</field><field name="model">smart.student</field><field name="arch" type="xml"><list string="Étudiants"><field name="name"/><field name="birthdate"/><field name="phone"/><field name="email"/><field name="study_level"/><field name="study_domain"/><field name="application_count"/></list></field></record>
    <record id="view_smart_student_form" model="ir.ui.view"><field name="name">smart.student.form</field><field name="model">smart.student</field><field name="arch" type="xml">
        <form string="Étudiant SMART"><sheet>
            <div class="oe_button_box" name="button_box"><button name="action_open_applications" type="object" class="oe_stat_button" icon="fa-folder-open"><field name="application_count" widget="statinfo" string="Dossiers"/></button></div>
            <div class="smart_title"><field name="photo" widget="image" class="oe_avatar"/><h1><field name="name"/></h1></div>
            <group><group string="Identité"><field name="last_name"/><field name="first_name"/><field name="birthdate"/><field name="birth_place"/><field name="nationality_id"/></group><group string="Contact"><field name="phone"/><field name="email"/><field name="street"/><field name="referral_name"/><field name="referral_phone"/></group></group>
            <notebook>
                <page string="Études"><group><group><field name="study_level"/><field name="study_domain"/><field name="current_school"/><field name="current_employer"/></group><group><field name="school_type"/><field name="destination_country_ids" widget="many2many_tags"/><field name="destination_cities"/><field name="hobbies"/></group></group><field name="studies_requested"/></page>
                <page string="Campus"><group><field name="campus_email"/><field name="campus_password" password="True" groups="smart_student_admission.group_smart_manager"/></group></page>
                <page string="Parents / Tuteurs"><field name="parent_ids"><list editable="bottom"><field name="first_name"/><field name="last_name"/><field name="relation"/><field name="profession"/><field name="phone"/><field name="email"/></list></field></page>
            </notebook>
        </sheet><chatter/></form>
    </field></record>
    <record id="action_smart_students" model="ir.actions.act_window"><field name="name">Étudiants</field><field name="res_model">smart.student</field><field name="view_mode">list,form</field></record>

    <record id="view_smart_application_list" model="ir.ui.view"><field name="name">smart.application.list</field><field name="model">smart.student.application</field><field name="arch" type="xml"><list string="Dossiers"><field name="name"/><field name="student_id"/><field name="country_id"/><field name="establishment"/><field name="requested_study"/><field name="application_type"/><field name="state" widget="badge"/><field name="total_due" widget="monetary"/><field name="balance_due" widget="monetary" groups="smart_student_admission.group_smart_manager"/></list></field></record>
    <record id="view_smart_application_form" model="ir.ui.view"><field name="name">smart.application.form</field><field name="model">smart.student.application</field><field name="arch" type="xml">
        <form string="Dossier étudiant SMART"><header>
            <button name="action_register" type="object" string="Inscrire" class="btn-primary" invisible="state != 'draft'"/>
            <button name="action_start" type="object" string="Démarrer" invisible="state != 'registered'"/>
            <button name="action_submit" type="object" string="Déposer candidatures" invisible="state != 'in_progress'"/>
            <button name="action_preinscription_obtained" type="object" string="Préinscription obtenue" class="btn-primary" invisible="state not in ('submitted','in_progress')"/>
            <button name="action_open_visa" type="object" string="Visa / Immigration" class="btn-primary" invisible="state not in ('preinscription','visa','visa_obtained')"/>
            <button name="action_create_engagement" type="object" string="Fiche d'engagement"/>
            <button name="action_create_invoice" type="object" string="Créer facture" class="btn-primary" groups="smart_student_admission.group_smart_manager"/>
            <button name="action_register_payment" type="object" string="Enregistrer paiement" groups="smart_student_admission.group_smart_manager"/>
            <button name="action_complete" type="object" string="Terminer" invisible="state != 'visa_obtained'"/>
            <button name="action_cancel" type="object" string="Annuler" invisible="state in ('completed','cancelled')"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,registered,in_progress,submitted,preinscription,visa,visa_obtained,completed"/>
        </header><sheet>
            <div class="oe_button_box" name="button_box">
                <button name="action_open_invoices" type="object" class="oe_stat_button" icon="fa-file-text" groups="smart_student_admission.group_smart_manager"><field name="invoice_count" widget="statinfo" string="Factures"/></button>
                <button name="action_open_payments" type="object" class="oe_stat_button" icon="fa-money" groups="smart_student_admission.group_smart_manager"><span class="o_stat_text">Paiements</span></button>
            </div>
            <div class="oe_title"><h1><field name="name"/></h1><h2><field name="student_id"/></h2></div>
            <group><group string="Dossier"><field name="student_id"/><field name="payer_partner_id"/><field name="academic_year"/><field name="registration_date"/><field name="package_id"/></group><group string="Destination"><field name="country_id"/><field name="city"/><field name="establishment"/><field name="requested_study"/><field name="application_type"/><field name="school_type"/></group></group>
            <group string="Finances"><group><field name="total_due" widget="monetary"/><field name="total_smart" widget="monetary"/><field name="total_external" widget="monetary"/></group><group groups="smart_student_admission.group_smart_manager"><field name="total_invoiced" widget="monetary"/><field name="total_paid" widget="monetary"/><field name="balance_due" widget="monetary"/></group></group>
            <notebook>
                <page string="Pièces"><field name="document_ids"><list editable="bottom"><field name="document_type_id"/><field name="name"/><field name="required"/><field name="state" widget="badge"/><field name="date_received"/><field name="expiry_date"/><field name="file" filename="filename"/><field name="filename" invisible="1"/></list></field></page>
                <page string="Préinscription"><field name="admission_date"/><field name="notes"/></page>
                <page string="Visa / Immigration"><field name="visa_application_ids"><list><field name="name"/><field name="country_id"/><field name="visa_type"/><field name="state" widget="badge"/><field name="date_submission"/><field name="date_decision"/></list></field></page>
                <page string="Engagement"><field name="engagement_ids"><list><field name="name"/><field name="date"/><field name="state" widget="badge"/><field name="total_amount" widget="monetary"/></list></field></page>
            </notebook>
        </sheet><chatter/></form>
    </field></record>
    <record id="action_smart_applications" model="ir.actions.act_window"><field name="name">Dossiers étudiants</field><field name="res_model">smart.student.application</field><field name="view_mode">list,form</field></record>

    <record id="view_smart_package_list" model="ir.ui.view"><field name="name">smart.package.list</field><field name="model">smart.service.package</field><field name="arch" type="xml"><list string="Formules"><field name="name"/><field name="country_id"/><field name="application_type"/><field name="smart_amount" widget="monetary"/><field name="external_amount" widget="monetary"/><field name="total_amount" widget="monetary"/></list></field></record>
    <record id="view_smart_package_form" model="ir.ui.view"><field name="name">smart.package.form</field><field name="model">smart.service.package</field><field name="arch" type="xml"><form string="Formule"><sheet><group><field name="name"/><field name="country_id"/><field name="application_type"/><field name="active"/></group><group><field name="smart_amount" widget="monetary"/><field name="external_amount" widget="monetary"/><field name="total_amount" widget="monetary"/></group><field name="fee_ids"><list editable="bottom"><field name="sequence"/><field name="name"/><field name="fee_type"/><field name="product_id"/><field name="amount"/><field name="stage"/><field name="is_external"/><field name="invoiceable"/></list></field><field name="note"/></sheet></form></field></record>
    <record id="action_smart_packages" model="ir.actions.act_window"><field name="name">Formules &amp; frais</field><field name="res_model">smart.service.package</field><field name="view_mode">list,form</field></record>

    <record id="view_smart_doc_type_list" model="ir.ui.view"><field name="name">smart.doc.type.list</field><field name="model">smart.document.type</field><field name="arch" type="xml"><list string="Types de pièces"><field name="sequence"/><field name="name"/><field name="country_id"/><field name="required_for_admission"/><field name="required_for_visa"/><field name="active"/></list></field></record>
    <record id="view_smart_doc_type_form" model="ir.ui.view"><field name="name">smart.doc.type.form</field><field name="model">smart.document.type</field><field name="arch" type="xml"><form string="Type de pièce"><sheet><group><field name="sequence"/><field name="name"/><field name="country_id"/><field name="required_for_admission"/><field name="required_for_visa"/><field name="active"/></group></sheet></form></field></record>
    <record id="action_smart_doc_types" model="ir.actions.act_window"><field name="name">Types de pièces</field><field name="res_model">smart.document.type</field><field name="view_mode">list,form</field></record>

    <record id="view_smart_engagement_list" model="ir.ui.view"><field name="name">smart.engagement.list</field><field name="model">smart.student.engagement</field><field name="arch" type="xml"><list string="Fiches d'engagement"><field name="name"/><field name="student_id"/><field name="application_id"/><field name="date"/><field name="state" widget="badge"/><field name="total_amount" widget="monetary"/></list></field></record>
    <record id="view_smart_engagement_form" model="ir.ui.view"><field name="name">smart.engagement.form</field><field name="model">smart.student.engagement</field><field name="arch" type="xml"><form string="Fiche d'engagement"><header><button name="action_ready" type="object" string="À signer" invisible="state != 'draft'"/><button name="action_sign" type="object" string="Marquer signé" class="btn-primary" invisible="state not in ('draft','ready')"/><button name="action_print" type="object" string="Imprimer" class="btn-secondary"/><field name="state" widget="statusbar" statusbar_visible="draft,ready,signed"/></header><sheet><group string="Signataire"><field name="application_id"/><field name="student_id"/><field name="payer_partner_id"/><field name="payer_name"/><field name="payer_phone"/><field name="payer_address"/><field name="date"/></group><group string="Montants"><field name="amount_dossier" widget="monetary"/><field name="amount_honoraires" widget="monetary"/><field name="total_amount" widget="monetary"/></group><field name="legal_text"/><field name="signed_by"/></sheet><chatter/></form></field></record>
    <record id="action_smart_engagements" model="ir.actions.act_window"><field name="name">Fiches d'engagement</field><field name="res_model">smart.student.engagement</field><field name="view_mode">list,form</field></record>

    <record id="view_smart_visa_list" model="ir.ui.view"><field name="name">smart.visa.list</field><field name="model">smart.visa.application</field><field name="arch" type="xml"><list string="Procédures Visa"><field name="name"/><field name="student_id"/><field name="country_id"/><field name="visa_type"/><field name="state" widget="badge"/><field name="date_submission"/><field name="date_decision"/><field name="step_count"/><field name="missing_step_count"/></list></field></record>
    <record id="view_smart_visa_form" model="ir.ui.view"><field name="name">smart.visa.form</field><field name="model">smart.visa.application</field><field name="arch" type="xml"><form string="Visa / Immigration"><header><button name="action_start" type="object" string="Préparer" invisible="state != 'draft'"/><button name="action_mark_complete" type="object" string="Dossier complet" invisible="state != 'documents'"/><button name="action_submit" type="object" string="Déposer" class="btn-primary" invisible="state != 'complete'"/><button name="action_appointment" type="object" string="Biométrie / rendez-vous" invisible="state != 'submitted'"/><button name="action_processing" type="object" string="En traitement" invisible="state not in ('submitted','appointment')"/><button name="action_decision" type="object" string="Décision" invisible="state != 'processing'"/><button name="action_obtained" type="object" string="Obtenu" class="btn-primary" invisible="state != 'decision'"/><button name="action_refused" type="object" string="Refusé" invisible="state != 'decision'"/><button name="action_create_caq" type="object" string="Gérer le CAQ" class="btn-primary" invisible="not is_canada"/><field name="state" widget="statusbar" statusbar_visible="draft,documents,complete,submitted,appointment,processing,decision,obtained"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1><h2><field name="student_id"/></h2></div><field name="is_canada" invisible="1"/><group><group><field name="application_id"/><field name="country_id"/><field name="visa_type"/><field name="date_start"/></group><group><field name="date_submission"/><field name="date_decision"/><field name="result_reference"/></group></group><notebook><page string="Processus"><div class="smart_action_bar"><button name="action_initialize_steps" type="object" string="Initialiser les étapes"/></div><field name="step_ids"><list editable="bottom"><field name="sequence"/><field name="name"/><field name="required"/><field name="state" widget="badge"/><field name="date_start"/><field name="date_done"/><field name="reference"/><field name="note"/></list></field></page><page string="CAQ Canada" invisible="not is_canada"><field name="caq_ids"><list><field name="name"/><field name="student_id"/><field name="institution"/><field name="program"/><field name="request_number"/><field name="state" widget="badge"/><field name="submission_date"/><field name="decision_date"/></list></field><button name="action_create_caq" type="object" string="Ouvrir / créer la demande CAQ" class="btn-primary"/></page><page string="Pièces"><field name="document_ids"><list editable="bottom"><field name="document_type_id"/><field name="name"/><field name="required"/><field name="state" widget="badge"/><field name="file" filename="filename"/><field name="filename" invisible="1"/></list></field></page><page string="Notes"><field name="note"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="view_smart_visa_stage_list" model="ir.ui.view"><field name="name">smart.visa.stage.list</field><field name="model">smart.visa.stage</field><field name="arch" type="xml"><list string="Étapes Visa"><field name="sequence"/><field name="country_id"/><field name="code"/><field name="name"/><field name="stage_kind"/><field name="required"/><field name="active"/></list></field></record>
    <record id="view_smart_visa_stage_form" model="ir.ui.view"><field name="name">smart.visa.stage.form</field><field name="model">smart.visa.stage</field><field name="arch" type="xml"><form string="Étape Visa"><sheet><group><field name="sequence"/><field name="country_id"/><field name="code"/><field name="name"/><field name="stage_kind"/><field name="required"/><field name="active"/></group></sheet></form></field></record>
    <record id="action_smart_visa" model="ir.actions.act_window"><field name="name">Visa / Immigration</field><field name="res_model">smart.visa.application</field><field name="view_mode">list,form</field></record>
    <record id="action_smart_visa_stages" model="ir.actions.act_window"><field name="name">Étapes Visa</field><field name="res_model">smart.visa.stage</field><field name="view_mode">list,form</field></record>

    <record id="view_smart_caq_list" model="ir.ui.view"><field name="name">smart.caq.list</field><field name="model">smart.caq</field><field name="arch" type="xml"><list string="Demandes CAQ"><field name="name"/><field name="student_id"/><field name="institution"/><field name="program"/><field name="request_number"/><field name="state" widget="badge"/><field name="submission_date"/><field name="decision_date"/></list></field></record>
    <record id="view_smart_caq_form" model="ir.ui.view"><field name="name">smart.caq.form</field><field name="model">smart.caq</field><field name="arch" type="xml"><form string="Demande de CAQ"><header><button name="action_submit" type="object" string="Soumettre" class="btn-primary" invisible="state != 'draft'"/><button name="action_processing" type="object" string="En traitement" invisible="state != 'submitted'"/><button name="action_obtained" type="object" string="CAQ obtenu" class="btn-primary" invisible="state != 'processing'"/><button name="action_refused" type="object" string="Refusé" invisible="state != 'processing'"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,processing,obtained"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="visa_application_id"/><field name="application_id"/><field name="student_id"/></group><group><field name="institution"/><field name="program"/><field name="level"/></group></group><group string="Suivi"><field name="request_number"/><field name="submission_date"/><field name="decision_date"/><field name="expiry_date"/></group><group string="Document"><field name="proof_file" filename="proof_filename"/><field name="proof_filename" invisible="1"/></group><field name="note"/></sheet><chatter/></form></field></record>
    <record id="action_smart_caq" model="ir.actions.act_window"><field name="name">Demandes CAQ</field><field name="res_model">smart.caq</field><field name="view_mode">list,form</field></record>

    <record id="action_report_smart_engagement" model="ir.actions.report"><field name="name">Fiche d'engagement SMART</field><field name="model">smart.student.engagement</field><field name="report_type">qweb-pdf</field><field name="report_name">smart_student_admission.report_engagement_document</field><field name="report_file">smart_student_admission.report_engagement_document</field><field name="print_report_name">'Engagement - %s' % (object.student_id.name or object.name)</field></record>
    <template id="report_engagement_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page" style="font-family:Arial,sans-serif;font-size:12px;"><div style="text-align:center;border-bottom:3px solid #8bc34a;padding-bottom:10px;margin-bottom:18px;"><h1 style="color:#76b82a;margin:0;">SMART</h1><div style="letter-spacing:2px;color:#777;">ASSISTANCE - CONSULTING - TRADING</div><h2>FICHE D'ENGAGEMENT</h2><div>Préinscription - Inscription à l'étranger</div></div><p><strong>Dossier :</strong> <span t-field="o.application_id.name"/></p><p><strong>Étudiant :</strong> <span t-field="o.student_id.name"/></p><p><strong>Destination :</strong> <span t-field="o.application_id.country_id.name"/></p><p><strong>Formation :</strong> <span t-field="o.application_id.requested_study"/></p><p><strong>Signataire :</strong> <span t-field="o.payer_name"/></p><p>Le client sollicite l'assistance de l'Agence SMART Assistance Consulting &amp; Trading pour l'accompagnement dans les démarches de préinscription ou d'inscription à l'étranger.</p><p>Les prestations et frais applicables sont ceux de la formule sélectionnée.</p><table class="table table-sm" style="width:100%;"><tr><th>Désignation</th><th class="text-end">Montant</th></tr><tr><td>Frais de dossier</td><td class="text-end"><span t-field="o.amount_dossier"/></td></tr><tr><td>Honoraires</td><td class="text-end"><span t-field="o.amount_honoraires"/></td></tr><tr><td><strong>Total</strong></td><td class="text-end"><strong><span t-field="o.total_amount"/></strong></td></tr></table><p style="margin-top:25px;color:#477a24;"><strong>Les frais externes applicables peuvent rester à la charge de l'étudiant.</strong></p><div style="margin-top:70px;display:flex;justify-content:space-between;"><div style="width:45%;text-align:center;">L'étudiant(e) ou son garant<br/><br/>Signature</div><div style="width:45%;text-align:center;">La Gérante<br/><br/>Signature et cachet</div></div></div></t></t></t></template>

    <menuitem id="menu_smart_root" name="SMART Étudiants" sequence="10" groups="smart_student_admission.group_smart_user"/>
    <menuitem id="menu_smart_students" name="Étudiants" parent="menu_smart_root" action="action_smart_students" sequence="10"/>
    <menuitem id="menu_smart_applications" name="Dossiers" parent="menu_smart_root" action="action_smart_applications" sequence="20"/>
    <menuitem id="menu_smart_engagements" name="Fiches d'engagement" parent="menu_smart_root" action="action_smart_engagements" sequence="30"/>
    <menuitem id="menu_smart_visa" name="Visa / Immigration" parent="menu_smart_root" action="action_smart_visa" sequence="40"/>
    <menuitem id="menu_smart_caq" name="CAQ Canada" parent="menu_smart_root" action="action_smart_caq" sequence="41"/>
    <menuitem id="menu_smart_config" name="Configuration" parent="menu_smart_root" sequence="90" groups="smart_student_admission.group_smart_manager"/>
    <menuitem id="menu_smart_packages" name="Formules &amp; frais" parent="menu_smart_config" action="action_smart_packages" sequence="10"/>
    <menuitem id="menu_smart_doc_types" name="Types de pièces" parent="menu_smart_config" action="action_smart_doc_types" sequence="20"/>
    <menuitem id="menu_smart_visa_stages" name="Étapes Visa" parent="menu_smart_config" action="action_smart_visa_stages" sequence="30"/>
</odoo>
