<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="smart_category" model="ir.module.category">
        <field name="name">SMART Assistance Étudiants</field><field name="sequence">35</field>
    </record>
    <record id="group_smart_user" model="res.groups">
        <field name="name">Utilisateur SMART Étudiants</field><field name="category_id" ref="smart_category"/>
    </record>
    <record id="group_smart_manager" model="res.groups">
        <field name="name">Responsable SMART Étudiants</field><field name="category_id" ref="smart_category"/>
        <field name="implied_ids" eval="[(4, ref('group_smart_user'))]"/>
    </record>
</odoo>
